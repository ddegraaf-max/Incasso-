<%
// Wezwanie online — bezpłatne wezwanie do zapłaty z linkiem, live odsetki, reactie van de dłużnik, QR.
// Teksten: t.wz (PL/EN). Na aanmaken: ?czeka=<token> → "bevestig je e-mail"; de link uit de mail (/w/<token>/potwierdz)
// toont de gegevens met de bevestigknop; daarna ?ok=<token>&k=<sleutel> → link, druk, registercheck en CTA.
var w = t.wz, c = t.common;
var errors = (typeof errors !== 'undefined' && errors) ? errors : {};
var form = (typeof form !== 'undefined' && form) ? form : {};
var ld = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: w.h1, url: site + '/wezwanie-online', applicationCategory: 'BusinessApplication', operatingSystem: 'Web', inLanguage: lang, isAccessibleForFree: true, description: w.metaDesc,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'PLN' }, provider: { '@type': 'Organization', name: 'sprzedamfakture.pl', url: site + '/' } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: w.faq.map(function (q) { return { '@type': 'Question', name: q[0], acceptedAnswer: { '@type': 'Answer', text: q[1] } }; }) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: t.kb.crumbsHome, item: site + '/' }, { '@type': 'ListItem', position: 2, name: w.kicker, item: site + '/wezwanie-online' }] },
];
var fe = function (k) { return errors[k] ? '<p class="field-err">' + w.errors[errors[k]] + '</p>' : ''; };
%><%- include('partials/head', { title: w.metaTitle, desc: w.metaDesc, ld: ld }) %>
<%- include('partials/nav') %>

<div class="calc-wrap" style="flex:1" id="main">
  <nav class="crumbs" aria-label="breadcrumb"><a href="/"><%= t.kb.crumbsHome %></a> › <span><%= w.kicker %></span></nav>
  <div class="kicker"><%= w.kicker %></div>
  <h1 style="font-size:clamp(30px, 4.2vw, 40px)"><%= w.h1 %></h1>
  <p class="lead" style="font-size:17px; color:var(--ink-70); max-width:66ch; line-height:1.6"><%= w.lead %></p>

  <% if (typeof okDemand !== 'undefined' && okDemand) { var d = okDemand, k = okCalc, viewUrl = '/w/' + d.token + (d.creditor_key ? '?k=' + encodeURIComponent(d.creditor_key) : ''); %>
  <div class="calc-result" style="margin-top:22px">
    <div class="kicker" style="margin-bottom:12px"><%= w.ok.kicker %></div>
    <h2 style="font-size:22px; margin:0 0 10px"><%= w.ok.h %></h2>
    <p class="helper" style="max-width:70ch"><%= w.ok.p %></p>
    <div class="field-row"><span class="fk"><%= w.ok.link %></span><span><a href="/w/<%= d.token %>" class="tnum" target="_blank" rel="noopener"><%= k.url %></a></span></div>
    <% if (d.creditor_key) { %><div class="field-row"><span class="fk"><%= w.ok.view %></span><span><a href="<%= viewUrl %>" target="_blank" rel="noopener"><%= w.ok.viewNote %></a></span></div><% } %>
    <div class="field-row"><span class="fk"><%= w.ok.print %></span><span><a href="/w/<%= d.token %>/druk" target="_blank" rel="noopener"><%= w.ok.printBtn %></a></span></div>
    <div class="field-row"><span class="fk"><%= w.ok.debtorMail %></span><span><%= d.debtor_email ? w.ok.debtorMailSent.replace('{email}', d.debtor_email) : w.ok.debtorMailNone %></span></div>
    <% if (typeof okFile !== 'undefined' && okFile) { %><div class="field-row"><span class="fk"><%= w.ok.file %></span><span><a href="/w/<%= d.token %>/zalacznik" target="_blank" rel="noopener"><%= okFile.filename %></a></span></div><% } %>
    <div class="field-row"><span class="fk"><%= w.ok.amount %></span><span class="tnum"><%= D.fmtN(k.total) %> zł (<%= D.fmtN(k.amount) %> + <%= D.fmtN(k.odsetki) %> + <%= D.fmtN(k.rekomp) %>)</span></div>
    <% var fs = okFacts; if (fs) { %><div class="field-row"><span class="fk"><%= w.ok.registers %></span><span><%= fs %></span></div><% } %>
    <div style="display:flex; gap:12px; flex-wrap:wrap; margin-top:16px">
      <a class="btn" href="<%= viewUrl %>" target="_blank" rel="noopener"><%= w.ok.open %></a>
      <a class="btn btn-secondary" href="/w/<%= d.token %>/druk" target="_blank" rel="noopener"><%= w.ok.printBtn %></a>
      <a class="btn btn-gold" href="/#wycena"><%= w.ok.sell %></a>
    </div>
  </div>
  <p class="helper" style="margin-top:14px; max-width:70ch"><%= w.ok.next %></p>
  <% } else if (typeof waitDemand !== 'undefined' && waitDemand) { var d = waitDemand, k = waitCalc, W = w.wait; %>
  <div class="calc-result" style="margin-top:22px">
    <div class="kicker" style="margin-bottom:12px"><%= W.kicker %></div>
    <h2 style="font-size:22px; margin:0 0 10px"><%= W.h %></h2>
    <% if (typeof waitMailFailed !== 'undefined' && waitMailFailed) { %>
    <p class="field-err"><%= W.mailErr %></p>
    <% } else { %>
    <p class="helper" style="max-width:70ch"><%= W.p1 %> <strong><%= d.creditor_email %></strong>. <%= W.p2 %></p>
    <% } %>
    <div class="field-row"><span class="fk"><%= W.invoice %></span><span class="tnum"><%= d.invoice_nr %></span></div>
    <div class="field-row"><span class="fk"><%= W.debtor %></span><span><%= d.debtor_company %></span></div>
    <div class="field-row"><span class="fk"><%= W.amount %></span><span class="tnum"><%= D.fmtN(k.total) %> zł</span></div>
    <p class="helper" style="margin:14px 0 0; max-width:70ch"><%= W.tips %> <%= W.why %></p>
    <div style="margin-top:16px"><a class="btn btn-secondary" href="/wezwanie-online"><%= W.again %></a></div>
  </div>
  <% } else if (typeof confirmDemand !== 'undefined' && confirmDemand) { var d = confirmDemand, k = confirmCalc, C = w.confirm; %>
  <div class="calc-result" style="margin-top:22px">
    <div class="kicker" style="margin-bottom:12px"><%= C.kicker %></div>
    <h2 style="font-size:22px; margin:0 0 10px"><%= C.h %></h2>
    <p class="helper" style="max-width:70ch"><%= C.p %></p>
    <div class="field-row"><span class="fk"><%= C.creditor %></span><span><%= d.creditor_company %></span></div>
    <div class="field-row"><span class="fk"><%= C.debtor %></span><span><%= d.debtor_company %></span></div>
    <div class="field-row"><span class="fk"><%= C.invoice %></span><span class="tnum"><%= d.invoice_nr %> · <%= d.due_date %></span></div>
    <div class="field-row"><span class="fk"><%= C.amount %></span><span class="tnum"><%= D.fmtN(k.total) %> zł (<%= D.fmtN(k.amount) %> + <%= D.fmtN(k.odsetki) %> + <%= D.fmtN(k.rekomp) %>)</span></div>
    <div class="field-row"><span class="fk"><%= C.sendTo %></span><span><%= d.debtor_email || C.sendNone %></span></div>
    <% if (typeof okFile !== 'undefined' && okFile) { %><div class="field-row"><span class="fk"><%= C.file %></span><span><%= okFile.filename %></span></div><% } %>
    <% if (confirmExpired) { %>
    <p class="field-err"><%= C.expired %></p>
    <div style="margin-top:16px"><a class="btn" href="/wezwanie-online"><%= C.again %></a></div>
    <% } else { %>
    <% if (typeof confirmLimit !== 'undefined' && confirmLimit) { %><p class="field-err"><%= C.limit %></p><% } %>
    <form method="post" action="/w/<%= d.token %>/potwierdz" style="margin-top:16px">
      <input type="hidden" name="k" value="<%= d.creditor_key %>">
      <button class="btn btn-gold" type="submit"><%= d.debtor_email ? C.btnSend : C.btn %></button>
    </form>
    <p class="helper" style="margin:12px 0 0; max-width:70ch"><%= C.note %></p>
    <% } %>
  </div>
  <% } else { %>

  <ul class="helper" style="max-width:70ch; padding-left:18px; line-height:1.7; margin-top:16px">
    <% w.bullets.forEach(function (b) { %><li><%- b %></li><% }) %>
  </ul>

  <div class="wz-example">
    <div class="kicker"><%= w.example.kicker %></div>
    <h2 style="font-size:22px; margin:6px 0 8px"><%= w.example.h %></h2>
    <p class="helper" style="margin:0 0 10px"><%= w.example.p %></p>
    <ul class="helper" style="padding-left:18px; margin:0 0 14px; line-height:1.7">
      <% w.example.items.forEach(function (i) { %><li><%- i %></li><% }) %>
    </ul>
    <a class="btn btn-secondary" href="/wezwanie-online/przyklad"><%= w.example.btn %></a>
  </div>

  <form class="calc-form" method="post" action="/wezwanie-online" enctype="multipart/form-data" novalidate>
    <input type="text" name="website" tabindex="-1" autocomplete="off" style="position:absolute; left:-9999px" aria-hidden="true">
    <div class="kicker" style="margin-bottom:10px"><%= w.f.creditorKicker %></div>
    <div class="form-grid2">
      <div class="fg"><label for="wz-cc"><%= w.f.creditorCompany %></label><input id="wz-cc" name="creditor_company" value="<%= form.creditor_company || '' %>" required><%- fe('creditor_company') %></div>
      <div class="fg"><label for="wz-ce"><%= w.f.creditorEmail %></label><input id="wz-ce" name="creditor_email" type="email" value="<%= form.creditor_email || '' %>" required><%- fe('creditor_email') %></div>
      <div class="fg"><label for="wz-cn"><%= w.f.creditorNip %></label><input id="wz-cn" name="creditor_nip" class="tnum" inputmode="numeric" value="<%= form.creditor_nip || '' %>"><%- fe('creditor_nip') %></div>
      <div class="fg"><label for="wz-ib"><%= w.f.iban %></label><input id="wz-ib" name="iban" class="tnum" value="<%= form.iban || '' %>" placeholder="PL61 1090 1014 0000 0712 1981 2874"><%- fe('iban') %></div>
    </div>
    <div class="kicker" style="margin:14px 0 10px"><%= w.f.debtorKicker %></div>
    <div class="form-grid2">
      <div class="fg"><label for="wz-dc"><%= w.f.debtorCompany %></label><input id="wz-dc" name="debtor_company" value="<%= form.debtor_company || '' %>" required><%- fe('debtor_company') %></div>
      <div class="fg"><label for="wz-dn"><%= w.f.debtorNip %></label><input id="wz-dn" name="debtor_nip" class="tnum" inputmode="numeric" value="<%= form.debtor_nip || '' %>"><%- fe('debtor_nip') %></div>
      <div class="fg"><label for="wz-de"><%= w.f.debtorEmail %></label><input id="wz-de" name="debtor_email" type="email" value="<%= form.debtor_email || '' %>"><%- fe('debtor_email') %></div>
    </div>
    <div class="kicker" style="margin:14px 0 10px"><%= w.f.invoiceKicker %></div>
    <div class="form-grid2">
      <div class="fg"><label for="wz-nr"><%= w.f.invoiceNr %></label><input id="wz-nr" name="invoice_nr" value="<%= form.invoice_nr || '' %>" placeholder="FV 2026/06/089" required><%- fe('invoice_nr') %></div>
      <div class="fg"><label for="wz-am"><%= w.f.amount %></label><input id="wz-am" name="amount" class="tnum" inputmode="decimal" value="<%= form.amount || '' %>" placeholder="12400" required><%- fe('amount') %></div>
      <div class="fg"><label for="wz-du"><%= w.f.due %></label><input id="wz-du" name="due_date" type="date" class="tnum" value="<%= form.due_date || '' %>" required><%- fe('due_date') %></div>
      <div class="fg"><label for="wz-file"><%= w.f.file %></label><input id="wz-file" name="zalacznik" type="file" accept=".pdf,.jpg,.jpeg,.png,.xml,application/pdf,image/jpeg,image/png,text/xml,application/xml"><%- fe('zalacznik') %><p class="helper" style="margin:6px 0 0"><%= w.f.fileNote %></p></div>
    </div>
    <%- include('partials/turnstile') %>
    <% if (errors.captcha) { %><p class="field-err"><%= w.errors.captcha %></p><% } %>
    <% if (errors.limit) { %><p class="field-err"><%= w.errors.dLimit %></p><% } %>
    <button class="btn" type="submit"><%= w.f.btn %></button>
    <p class="helper" style="margin:12px 0 0"><%= w.f.note %></p>
  </form>

  <h2 style="margin-top:36px"><%= w.how.h %></h2>
  <% w.how.steps.forEach(function (s, i) { %>
  <p class="helper" style="max-width:70ch"><strong><%= (i + 1) %>.</strong> <%- s %></p>
  <% }) %>

  <h2 style="margin-top:30px"><%= w.faqH %></h2>
  <% w.faq.forEach(function (q) { %>
  <h3 style="font-size:17px; margin-top:18px"><%= q[0] %></h3>
  <p class="helper" style="max-width:70ch"><%= q[1] %></p>
  <% }) %>
  <p class="legal-note"><%= w.legal %></p>
  <% } %>
</div>

<%- include('partials/footer') %>

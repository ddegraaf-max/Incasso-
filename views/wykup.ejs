<% var W = t.app.wykup; %>
<%- include('partials/head', { title: t.app.titles.wykup + ' — sprzedamfakture.pl' }) %>
<%- include('partials/nav') %>

<div class="wykup-wrap" style="flex:1">
  <div class="kicker"><%= W.kicker %></div>
  <p class="intro helper" style="max-width:72ch"><%= W.intro %></p>

  <table class="cases wykup">
    <thead>
      <tr><th><%= W.th.invoice %></th><th><%= W.th.debtor %></th><th class="num"><%= W.th.amount %></th><th><%= W.th.aiscore %></th><th class="num"><%= W.th.offer %></th><th></th></tr>
    </thead>
    <tbody>
      <% D.claims.forEach(function(c) {
        var sold = done[c.id] === 'sell';
        var scoreTag = (c.ai.grade === 'E' || c.ai.grade === 'D') ? 'tag-accent' : (c.ai.grade === 'C' ? 'tag-outline' : 'tag-neutral');
      %>
      <tr>
        <td class="tnum"><%= c.nr %></td>
        <td><%= c.debtor %></td>
        <td class="num tnum"><%= D.fmt(c.amount) %></td>
        <td><span class="tag <%= scoreTag %>"><span class="tnum"><%= c.ai.score %></span> · <%= c.ai.grade %></span></td>
        <td class="num tnum"><%= D.fmt(Math.round(c.amount * c.pct / 100)) %> · <%= c.pct %>%</td>
        <td>
          <% if (sold) { %>
            <span class="tag tag-accent"><%= W.sold %></span>
          <% } else { %>
            <form class="inline" method="post" action="/app/wykup/<%= c.id %>/sprzedaj">
              <button class="btn btn-secondary" type="submit"><%= W.accept %></button>
            </form>
          <% } %>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>

  <p class="legal-note"><%= W.note %></p>
</div>

<%- include('partials/footer') %>

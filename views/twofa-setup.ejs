<% var F = t.app.twofaSetup; %>
<%- include('partials/head', { title: t.app.titles.twofaSetup + ' — sprzedamfakture.pl' }) %>
<%- include('partials/nav') %>

<div class="calc-wrap auth-wrap" style="flex:1">
  <div class="kicker"><%= F.kicker %></div>
  <h1 style="font-size:32px"><%= F.h %></h1>
  <p class="helper"><%= F.helper %></p>

  <form class="calc-form" method="post" action="/2fa/setup">
    <% if (error) { %><div class="form-error" role="alert"><%= error %></div><% } %>
    <div class="fg" style="text-align:left">
      <img src="<%= qr %>" alt="<%= F.qrAlt %>" width="196" height="196" style="border:1px solid var(--color-divider); border-radius:12px; background:#fff; padding:8px">
    </div>
    <div class="fg">
      <label><%= F.manual %></label>
      <div class="tnum" style="font-size:14px; letter-spacing:0.06em; word-break:break-all"><%= secret %></div>
    </div>
    <div class="fg">
      <label for="token"><%= F.code %></label>
      <input type="text" id="token" name="token" class="tnum" inputmode="numeric" pattern="[0-9 ]*" maxlength="7" autocomplete="one-time-code" required autofocus>
    </div>
    <button class="btn" type="submit"><%= F.btn %></button>
  </form>
</div>

<%- include('partials/footer') %>

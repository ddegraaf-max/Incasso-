<% var M = t.app.admin, fill = t.fill; var ig = (typeof integr !== 'undefined' && integr) ? integr : {}; %>
<%- include('partials/head', { title: t.app.titles.admin + ' — sprzedamfakture.pl' }) %>
<%- include('partials/nav') %>

<div class="stats">
  <div class="stat"><div class="v tnum"><%= usersList.filter(u => u.role === 'client').length %></div><div class="l"><%= M.stats.clients %></div></div>
  <div class="stat"><div class="v tnum"><%= D.claims.length %></div><div class="l"><%= M.stats.cases %></div></div>
  <div class="stat"><div class="v tnum accent"><%= Object.values(done).filter(v => v === 'collect').length %></div><div class="l"><%= M.stats.collections %></div></div>
  <div class="stat"><div class="v tnum"><%= Object.values(done).filter(v => v === 'sell').length %></div><div class="l"><%= M.stats.bought %></div></div>
</div>

<div class="two-pane">
  <div class="pane-left">
    <% if (typeof flash !== 'undefined' && flash) { %><div class="confirm" style="margin-bottom:16px"><span class="sq"></span><span><%= flash %></span></div><% } %>
    <div class="kicker"><%= M.usersKicker %></div>
    <p class="helper"><%= M.usersHelper %></p>
    <table class="cases">
      <thead>
        <tr><th><%= M.th.company %></th><th><%= M.th.email %></th><th><%= M.th.nip %></th><th><%= M.th.role %></th><th><%= M.th.twofa %></th></tr>
      </thead>
      <tbody>
        <% usersList.forEach(function(u) { %>
        <tr>
          <td><%= u.company || '—' %></td>
          <td><%= u.email %></td>
          <td class="tnum"><%= u.nip || '—' %></td>
          <td><span class="tag <%= u.role === 'admin' ? 'tag-accent' : 'tag-neutral' %>"><%= u.role %></span></td>
          <td><span class="tag <%= u.totpConfirmed ? 'tag-outline' : 'tag-neutral' %>"><%= u.totpConfirmed ? M.on : M.off %></span></td>
        </tr>
        <% }) %>
      </tbody>
    </table>

    <hr class="rule">
    <div class="kicker"><%= M.integrLabel %></div>
    <ul class="rules-list">
      <li><span class="tag <%= ig.resend ? 'tag-accent' : 'tag-neutral' %>"><%= ig.resend ? M.integrOn : M.integrOff %></span> &nbsp;<%= M.integr.resend %> · <%= M.integr.from %>: <span class="tnum"><%= ig.from || '—' %></span></li>
      <li><span class="tag <%= ig.turnstile ? 'tag-accent' : 'tag-neutral' %>"><%= ig.turnstile ? M.integrOn : M.integrOff %></span> &nbsp;<%= M.integr.turnstile %></li>
      <li><span class="tag <%= ig.notify ? 'tag-accent' : 'tag-neutral' %>"><%= ig.notify ? M.integrOn : M.integrOff %></span> &nbsp;<%= M.integr.notify %> <span class="tnum"><%= ig.notify || M.notSet %></span></li>
      <li><span class="tag <%= ig.liveComms ? 'tag-accent' : 'tag-neutral' %>"><%= ig.liveComms ? M.integrOn : M.integrOff %></span> &nbsp;<%= M.integr.live %></li>
      <li><span class="tag <%= ig.smsapi ? 'tag-accent' : 'tag-neutral' %>"><%= ig.smsapi ? M.integrOn : M.integrOff %></span> &nbsp;<%= M.integr.sms %></li>
      <li><span class="tag <%= ig.anthropic ? 'tag-accent' : 'tag-neutral' %>"><%= ig.anthropic ? M.integrOn : M.integrOff %></span> &nbsp;<%= M.integr.ai %></li>
      <li><span class="tag <%= ig.db ? 'tag-accent' : 'tag-neutral' %>"><%= ig.db ? M.integrOn : M.integrOff %></span> &nbsp;<%= M.integr.db %></li>
    </ul>
    <% (ig.problems || []).forEach(function(p) { %>
    <p class="field-err" style="margin-top:10px">⚠ <%= p %></p>
    <% }) %>
    <form method="post" action="/admin/test-mail" style="margin-top:14px; display:flex; gap:12px; align-items:center; flex-wrap:wrap">
      <button class="btn btn-secondary chan-btn" type="submit"><%= M.testMail %></button>
      <span class="helper" style="margin:0"><%= M.testMailHint %></span>
    </form>
  </div>

  <aside class="pane-right">
    <div class="kicker"><%= M.casesKicker %></div>
    <table class="cases">
      <thead><tr><th><%= M.th.invoice %></th><th class="num"><%= M.th.amount %></th><th><%= M.th.status %></th></tr></thead>
      <tbody>
        <% D.claims.forEach(function(c) { var st = done[c.id]; %>
        <tr>
          <td class="tnum"><%= c.nr %></td>
          <td class="num tnum"><%= D.fmt(c.amount) %></td>
          <td><span class="tag <%= st ? 'tag-accent' : 'tag-neutral' %>"><%= st === 'collect' ? M.stCollect : st === 'sell' ? M.stSold : t.tr(c.phase) %></span></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <hr class="rule">
    <div class="label"><%= M.leadsLabel %></div>
    <% if (!leads.length) { %><p class="helper"><%= M.noLeads %></p><% } %>
    <% leads.slice(0, 6).forEach(function(l) { %>
    <div class="feed-row">
      <span class="time tnum"><%= new Date(l.created_at).toLocaleDateString(t.locale, {day:'numeric', month:'short'}) %></span>
      <span class="dot"></span>
      <span>
        <div class="fx"><%= l.company %><% if (l.forma) { %> → <%= t.app.formaLabels[l.forma] || l.forma %><% } %> · <span class="tnum"><%= fill(M.leadLine, { kwota: D.fmt(Number(l.kwota)), dni: l.dni, pct: l.oferta_pct }) %></span></div>
        <div class="fr2 tnum"><%= l.email %> · <%= l.tel || '' %> · <%= fill(M.leadNip, { nip: l.nip }) %></div>
      </span>
    </div>
    <% }) %>

    <hr class="rule">
    <div class="label"><%= M.eventsLabel %></div>
    <% events.slice(0, 8).forEach(function(ev) { %>
    <div class="feed-row">
      <span class="time tnum"><%= new Date(ev.created_at).toLocaleTimeString(t.locale, {hour:'2-digit', minute:'2-digit'}) %></span>
      <span class="dot"></span>
      <span>
        <div class="fx"><%= t.tr(ev.title) %></div>
        <div class="fr2"><%= ev.debtor || M.system %> · <%= t.tr(ev.source) %></div>
      </span>
    </div>
    <% }) %>

    <hr class="rule">
    <div class="label"><%= M.secLabel %></div>
    <ul class="rules-list">
      <% M.sec.forEach(function(s) { %><li><%= s %></li><% }) %>
    </ul>
  </aside>
</div>

<%- include('partials/footer') %>

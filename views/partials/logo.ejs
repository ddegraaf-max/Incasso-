<%
/* sprzedamfakture.pl — logo (beeldmerk + woordmerk), huisstijl v0.25: document met vinkje in teal
   Opties: size ('sm' | 'lg'), tagline (bool), tagText, asLink (default true), href, light (bool, op donkere achtergrond) */
var lgSize = (typeof size !== 'undefined' && size) ? ' brand-' + size : '';
var lgTag = (typeof tagline !== 'undefined') && !!tagline;
var lgTagText = (typeof tagText !== 'undefined' && tagText) ? tagText : ((typeof t !== 'undefined' && t && t.common && t.common.tagline) ? t.common.tagline : 'Skup faktur · Szybkie finansowanie · Płynność firmy');
var lgLink = (typeof asLink === 'undefined') ? true : !!asLink;
var lgHref = (typeof href !== 'undefined' && href) ? href : '/';
var lgLight = (typeof light !== 'undefined') && !!light;
var lgEl = lgLink ? 'a' : 'span';
%>
<<%= lgEl %> class="brand<%= lgSize %><%= lgLight ? ' brand-light' : '' %>"<% if (lgLink) { %> href="<%= lgHref %>" aria-label="sprzedamfakture.pl — strona główna"<% } %>>
  <svg class="brand-mark" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
    <path class="brand-sheet" d="M10 4h17l10 10v24a4 4 0 0 1-4 4H10a4 4 0 0 1-4-4V8a4 4 0 0 1 4-4z" fill="#ffffff" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/>
    <path d="M27 4v7a3 3 0 0 0 3 3h7" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/>
    <g class="brand-lines" stroke="currentColor" stroke-width="3" stroke-linecap="round">
      <path d="M13 20h12"/><path d="M13 27h16"/><path d="M13 34h9"/>
    </g>
    <circle cx="36" cy="36" r="10" class="brand-coin" fill="#12a38b"/>
    <path d="M31 36.4l3.4 3.3 6.6-7" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
  <span class="brand-text">
    <span class="brand-word">sprzedam<b>fakture</b><i>.pl</i></span>
    <% if (lgTag) { %><span class="brand-tag"><%= lgTagText %></span><% } %>
  </span>
</<%= lgEl %>>

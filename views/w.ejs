<%
// /w/<token> — het "levende" wezwanie: bedrag van vandaag, reactieknoppen voor de dłużnik, QR voor print.
// De brief zelf is altijd Pools (taal van de dłużnik); de UI-hints volgen t.wz.letter (PL/EN).
var w = t.wz, L = w.letter;
var st = d.status || 'wyslane';
var answered = ['obietnica', 'zaplacone', 'spor'].indexOf(st) !== -1;
var thanks = typeof thanksMsg !== 'undefined' && thanksMsg;
var isDemo = typeof demo !== 'undefined' && demo;
var X = w.example;
// Podgląd wierzyciela: /w/<token>?k=<sleutel> — status, otwarcia en odpowiedzi; geen reactieformulier
var isCred = typeof creditorView !== 'undefined' && creditorView && typeof hist !== 'undefined' && hist;
var rErr = typeof respondError !== 'undefined' && respondError;
var rf = (typeof respondForm !== 'undefined' && respondForm) ? respondForm : {};
%><%- include('partials/head', isDemo ? { title: X.metaTitle, desc: X.metaDesc, noindex: false, altLang: true } : { title: 'Wezwanie do zapłaty — ' + d.invoice_nr, desc: L.metaDesc, noindex: true, altLang: false }) %>
<% if (isDemo) { %><%- include('partials/nav') %>
<div class="wz-demo-bar"><span class="tag tag-accent"><%= X.badge %></span> <span><%= X.bar %></span> <a class="btn btn-gold chan-btn" href="/wezwanie-online"><%= X.cta %></a></div>
<% } %>
<div class="wz-doc">
  <div class="wz-head">
    <%- include('partials/logo', { asLink: true, href: '/', tagline: false }) %>
    <div class="wz-meta tnum">
      <div><%= L.issued %>: <%= k.issued %></div>
      <div><%= L.ref %>: <%= d.token %></div>
    </div>
  </div>

  <% if (thanks) { %><div class="confirm" style="margin:0 0 18px"><span class="sq"></span><span><%= thanks %></span></div><% } %>

  <% if (isCred) { var C = L.cred; %>
  <div class="wz-cred no-print">
    <div class="label"><%= C.h %></div>
    <p class="helper" style="margin:0 0 10px"><%= C.note %></p>
    <div class="field-row"><span class="fk"><%= C.share %></span><span class="tnum"><%= k.url %></span></div>
    <div class="field-row"><span class="fk"><%= C.opened %></span><span class="tnum"><%= hist.firstOpen ? fmtTs(hist.firstOpen) + (hist.opens > 1 ? ' · ' + C.times.replace('{n}', hist.opens) + ' ' + fmtTs(hist.lastOpen) : '') : C.notYet %></span></div>
    <% if (!hist.responses.length) { %><div class="field-row"><span class="fk"><%= C.responses %></span><span><%= C.none %></span></div><% } %>
    <% hist.responses.forEach(function (r) { %>
    <div class="field-row"><span class="fk"><%= C.responses %></span><span><span class="tnum"><%= fmtTs(r.at) %></span> · <strong><%= L.status[r.status] || r.status %></strong><% if (r.date) { %> <span class="tnum">(<%= r.status === 'obietnica' ? L.promisedOn : L.paidOn %> <%= r.date %>)</span><% } %><% if (r.note) { %><br><%= r.note %><% } %></span></div>
    <% }) %>
    <p class="helper" style="margin:10px 0 0"><%= C.evidence %></p>
  </div>
  <% } %>

  <div class="wz-status">
    <span class="tag <%= st === 'zaplacone' ? 'tag-accent' : (st === 'spor' ? 'tag-outline' : 'tag-neutral') %>"><%= L.status[st] || st %></span>
    <% if (st === 'obietnica' && d.promised_date) { %><span class="tnum"> · <%= L.promisedOn %> <%= d.promised_date %></span><% } %>
    <% if (st === 'zaplacone' && d.paid_date) { %><span class="tnum"> · <%= L.paidOn %> <%= d.paid_date %></span><% } %>
    <span class="tnum wz-live" title="<%= L.liveTitle %>"> · <%= L.live %></span>
  </div>

  <div class="wz-parties">
    <div><div class="label"><%= L.creditor %></div><div class="wz-party"><%= d.creditor_company %><% if (d.creditor_nip) { %><br><span class="tnum">NIP <%= d.creditor_nip %></span><% } %></div></div>
    <div><div class="label"><%= L.debtor %></div><div class="wz-party"><%= d.debtor_company %><% if (d.debtor_nip) { %><br><span class="tnum">NIP <%= d.debtor_nip %></span><% } %></div></div>
  </div>

  <h1>Wezwanie do zapłaty</h1>
  <p class="wz-p">Działając w imieniu wierzyciela <strong><%= d.creditor_company %></strong>, na podstawie art. 4a, 7 i 10 ustawy z dnia 8 marca 2013 r. o przeciwdziałaniu nadmiernym opóźnieniom w transakcjach handlowych, wzywamy do zapłaty należności wynikającej z faktury <strong class="tnum"><%= d.invoice_nr %></strong>, której termin płatności (<span class="tnum"><%= d.due_date %></span>) upłynął <strong class="tnum"><%= k.days %></strong> dni temu.</p>

  <table class="wz-table tnum">
    <tr><td>Należność główna (faktura <%= d.invoice_nr %>)</td><td><%= D.fmtN(k.amount) %> zł</td></tr>
    <tr><td>Odsetki ustawowe za opóźnienie (<%= k.rate %>% × <%= k.days %> dni, na dziś)</td><td><%= D.fmtN(k.odsetki) %> zł</td></tr>
    <tr><td>Rekompensata za koszty odzyskiwania należności (art. 10)</td><td><%= D.fmtN(k.rekomp) %> zł</td></tr>
    <tr class="total"><td>Razem do zapłaty na dziś</td><td><%= D.fmtN(k.total) %> zł</td></tr>
  </table>

  <% if (typeof file !== 'undefined' && file) { %><p class="wz-p"><strong><%= L.attachment %>:</strong> <a href="/w/<%= d.token %>/zalacznik" target="_blank" rel="noopener"><%= file.filename %></a> <span class="tnum" style="color:var(--ink-55)">(<%= Math.max(1, Math.round((file.size || 0) / 1024)) %> KB)</span></p><% } %>
  <p class="wz-p">Prosimy o zapłatę w terminie do <strong class="tnum"><%= k.deadline %></strong><% if (d.iban) { %> na rachunek <strong class="tnum"><%= d.iban %></strong><% } %>, z podaniem numeru faktury w tytule przelewu. Odsetki naliczane są w dalszym ciągu, do dnia zapłaty — kwota na tej stronie aktualizuje się codziennie.</p>
  <p class="wz-p">Brak zapłaty w terminie może skutkować skierowaniem sprawy do windykacji, zgłoszeniem dłużnika do biura informacji gospodarczej (KRD / BIG) oraz na drogę postępowania sądowego, którego koszty obciążą dłużnika.</p>

  <div class="wz-respond no-print" id="odpowiedz">
    <div class="label"><%= L.respondH %></div>
    <p class="helper" style="margin:0 0 12px"><%= answered ? L.respondDone : (isCred ? L.cred.formHidden : L.respondP) %></p>
    <% if (rErr && (answered || isCred)) { %><p class="field-err"><%= rErr %></p><% } %>
    <% if (!answered && !isCred) { %>
    <form method="post" action="<%= isDemo ? '#' : '/w/' + d.token + '/odpowiedz' %>" class="calc-form flat wz-form" <% if (isDemo) { %>onsubmit="return false"<% } %>>
      <input type="text" name="website" tabindex="-1" autocomplete="off" style="position:absolute; left:-9999px" aria-hidden="true">
      <div class="wz-choices">
        <label class="wz-choice"><input type="radio" name="action" value="paid" required<%= rf.action === 'paid' ? ' checked' : '' %>> <span><strong><%= L.paid %></strong><br><small><%= L.paidHint %></small></span></label>
        <label class="wz-choice"><input type="radio" name="action" value="promise"<%= rf.action === 'promise' ? ' checked' : '' %>> <span><strong><%= L.promise %></strong><br><small><%= L.promiseHint %></small></span></label>
        <label class="wz-choice"><input type="radio" name="action" value="dispute"<%= rf.action === 'dispute' ? ' checked' : '' %>> <span><strong><%= L.dispute %></strong><br><small><%= L.disputeHint %></small></span></label>
      </div>
      <div class="form-grid2" style="margin-top:12px">
        <div class="fg"><label for="wz-date"><%= L.date %></label><input id="wz-date" name="date" type="date" class="tnum" value="<%= rf.date || '' %>"></div>
        <div class="fg"><label for="wz-note"><%= L.note %></label><textarea id="wz-note" name="note" rows="3" maxlength="1000" placeholder="<%= L.notePh %>"><%= rf.note || '' %></textarea></div>
      </div>
      <% if (!isDemo) { %><%- include('partials/turnstile') %><% } %>
      <% if (rErr) { %><p class="field-err"><%= rErr %></p><% } %>
      <button class="btn" type="submit" <%= isDemo ? 'disabled' : '' %>><%= L.send %></button>
      <p class="helper" style="margin:10px 0 0"><%= isDemo ? X.disabled : L.sendNote %></p>
    </form>
    <% } %>
    <% if (rErr) { %><script>document.getElementById('odpowiedz').scrollIntoView();</script><% } %>
  </div>

  <div class="wz-foot">
    <div class="wz-qr"><img src="<%= qr %>" alt="QR" width="96" height="96"><div class="tnum" style="font-size:11px; color:var(--ink-55); margin-top:4px"><%= k.url.replace(/^https?:\/\//, '') %></div></div>
    <div class="wz-foot-txt">
      <p><%= L.footer %></p>
      <p class="tnum"><%= company.name %> · <%= company.street %>, <%= company.city %> · KvK <%= company.kvk %> · VAT <%= company.vat %> · <a href="mailto:<%= company.email %>"><%= company.email %></a></p>
      <div class="no-print" style="display:flex; gap:12px; flex-wrap:wrap; margin-top:10px">
        <a class="btn btn-secondary chan-btn" href="/w/<%= d.token %>/druk" target="_blank" rel="noopener"><%= L.print %></a>
        <a class="btn btn-ghost chan-btn" href="/wezwanie-online"><%= L.makeOwn %></a>
      </div>
    </div>
  </div>
</div>

<% if (isDemo) { %>
<div class="wz-doc" style="padding-top:0">
  <h2 style="font-size:24px"><%= X.mailsH %></h2>
  <p class="helper" style="max-width:70ch"><%= X.mailsP %></p>
  <div class="label" style="margin-top:18px"><%= X.debtorMailH %></div>
  <div class="field-row"><span class="fk"><%= X.from %></span><span><%= mails.debtorFrom %></span></div>
  <div class="field-row"><span class="fk"><%= X.to %></span><span><%= d.debtor_email %></span></div>
  <div class="field-row"><span class="fk"><%= X.replyTo %></span><span><%= d.creditor_email %></span></div>
  <div class="field-row"><span class="fk"><%= X.subject %></span><span><%= mails.debtorSubject %></span></div>
  <div class="field-row"><span class="fk"><%= X.attachment %></span><span><%= file.filename %></span></div>
  <pre class="mail-body" style="margin-top:10px"><%= mails.debtorText %></pre>
  <div class="label" style="margin-top:26px"><%= X.creditorMailH %></div>
  <div class="field-row"><span class="fk"><%= X.to %></span><span><%= d.creditor_email %></span></div>
  <div class="field-row"><span class="fk"><%= X.subject %></span><span><%= mails.creditorSubject %></span></div>
  <pre class="mail-body" style="margin-top:10px"><%= mails.creditorText %></pre>
  <div style="display:flex; gap:12px; flex-wrap:wrap; margin-top:22px">
    <a class="btn btn-gold" href="/wezwanie-online"><%= X.cta %></a>
    <a class="btn btn-ghost chan-btn" href="/baza-wiedzy/wezwanie-do-zaplaty-wzor"><%= X.readMore %></a>
  </div>
</div>
<% } %>
<%- include('partials/footer') %>

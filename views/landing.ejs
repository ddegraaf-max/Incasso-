<!DOCTYPE html>
<html lang="<%= t.htmlLang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= t.metaTitle %></title>
<meta name="description" content="<%= t.metaDesc %>">
<link rel="alternate" hreflang="pl" href="/?lang=pl">
<link rel="alternate" hreflang="en" href="/?lang=en">
<link rel="stylesheet" href="/css/app.css">
</head>
<body>
<div style="min-height:100vh; display:flex; flex-direction:column">

<nav class="nav">
  <a class="nav-brand" href="/?lang=<%= lang %>">
    <span class="b1">Creditline</span>
    <span class="b2"></span>
    <span class="b3"><span>P</span><span>O</span><span>L</span><span>A</span><span>N</span><span>D</span></span>
  </a>
  <span class="nav-right nav-links">
    <a href="#uslugi"><%= t.navServices %></a>
    <a href="#dlaczego"><%= t.navWhy %></a>
    <a href="#kontakt"><%= t.navContact %></a>
    <a href="/kalkulator"><%= t.navCalc %></a>
    <a href="/app/sprawy"><%= t.navApp %></a>
    <span class="lang-switch">
      <a href="/?lang=pl" class="<%= lang === 'pl' ? 'active' : '' %>">PL</a><span class="sep">·</span><a href="/?lang=en" class="<%= lang === 'en' ? 'active' : '' %>">EN</a>
    </span>
  </span>
</nav>

<section class="hero">
  <canvas id="hero-net" aria-hidden="true"></canvas>
  <div class="hero-inner">
    <div class="hero-copy">
      <h1><%= t.heroH1 %></h1>
      <p class="sub"><%= t.heroSub %></p>
      <div class="cta">
        <a class="btn" href="#kontakt"><%= t.ctaTalk %></a>
        <a class="btn btn-secondary" href="/app/sprawy"><%= t.ctaSee %></a>
      </div>
    </div>
    <div class="hero-visual" aria-hidden="true">
      <div class="hero-card">
        <div class="hc-top">
          <span class="hc-brand">Creditline <em>Poland</em></span>
          <span class="hc-seal tnum">14%</span>
        </div>
        <div class="hc-title">Wezwanie do zapłaty</div>
        <div class="hc-row"><span>Faktura</span><span class="tnum">FV 2026/06/089</span></div>
        <div class="hc-row"><span>Należność</span><span class="tnum">12 400 zł</span></div>
        <div class="hc-row"><span>Odsetki</span><span class="tnum">597 zł</span></div>
        <div class="hc-row hc-total"><span>Razem</span><span class="tnum">13 297 zł</span></div>
        <div class="hc-bar"><span class="hc-fill"></span></div>
        <div class="hc-foot">AIScore 67 · klasa C · windykacja w toku</div>
      </div>
      <div class="hero-chip hc-a tnum">+ rekompensata 300 zł</div>
      <div class="hero-chip hc-b">KRZ: brak wpisów</div>
    </div>
  </div>
</section>

<div class="stats-strip">
  <% t.stats.forEach(function(s) { %>
  <div class="cell"><div class="v tnum"><%= s[0] %><sup class="src-ref"><%= s[2] %></sup></div><div class="l"><%= s[1] %></div></div>
  <% }) %>
</div>

<section class="svc-wrap" id="uslugi">
  <div class="kicker svc-kicker"><%= t.svcKicker %></div>
  <div class="svc">
    <% t.services.forEach(function(s) { %>
    <div class="cell">
      <div class="num"><%= s[0] %></div>
      <h3><%= s[1] %></h3>
      <p><%= s[2] %></p>
    </div>
    <% }) %>
  </div>
</section>

<section class="law">
  <div class="kicker"><%= t.lawKicker %></div>
  <div class="law-grid">
    <% t.law.forEach(function(l) { %>
    <div class="cell">
      <div class="v tnum"><%= l[0] %><sup class="src-ref"><%= l[3] %></sup></div>
      <h4><%= l[1] %></h4>
      <p><%= l[2] %></p>
    </div>
    <% }) %>
  </div>
  <p style="margin-top:24px"><a href="/kalkulator"><%= t.calcLink %></a></p>
</section>

<section class="path">
  <div class="kicker"><%= t.pathKicker %></div>
  <div class="path-grid">
    <% t.path.forEach(function(p) { %>
    <div class="cell">
      <div class="p-step tnum"><%= p[0] %></div>
      <div class="p-desc"><%= p[1] %></div>
    </div>
    <% }) %>
  </div>
</section>

<section class="model">
  <div class="kicker"><%= t.modelKicker %></div>
  <div class="model-grid">
    <% t.model.forEach(function(m, i) { %>
    <div class="cell <%= i === 2 ? 'alt' : '' %>">
      <div class="m-who"><%= m[0] %></div>
      <h4><%= m[1] %></h4>
      <p><%= m[2] %></p>
    </div>
    <% }) %>
  </div>
</section>

<section class="why" id="dlaczego">
  <div class="why-grid">
    <div class="cell">
      <div class="kicker"><%= t.whyKicker %></div>
      <h2><%= t.whyH %></h2>
      <p><%= t.whyP %><sup class="src-ref"><%= t.whySup %></sup></p>
    </div>
    <div class="cell">
      <div class="kicker"><%= t.nowKicker %></div>
      <% t.now.forEach(function(n) { %>
      <div class="now-row">
        <div class="n-v tnum"><%= n[0] %><sup class="src-ref"><%= n[2] %></sup></div>
        <div class="n-p"><%= n[1] %></div>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="closing" id="kontakt">
  <h2><%= t.closingH %></h2>
  <div class="cta" style="display:flex; gap:14px; margin-top:20px; flex-wrap:wrap">
    <a class="btn" href="mailto:kontakt@creditline.pl"><%= t.ctaCall %></a>
    <a class="btn btn-ghost" href="/app/sprawy"><%= t.ctaPanel %></a>
  </div>
</section>

<footer class="sources">
  <div class="kicker" style="color:var(--ink-70)"><%= t.srcKicker %></div>
  <ol>
    <% t.sources.forEach(function(s) { %><li><%= s %></li><% }) %>
  </ol>
  <div class="cr"><%= t.copyright %> · kontakt@creditline.pl</div>
</footer>

</div>
<script src="/js/motion.js" defer></script>
</body>
</html>

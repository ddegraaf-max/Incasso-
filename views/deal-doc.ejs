<%
// Document van een wykup (umowa przelewu / zawiadomienie) als leesbare pagina met afdrukstijl.
// Verwacht: title, blocks [{type,text,left,right,leftLabel,rightLabel}], summary (NL, optioneel), summaryLabel, pdfUrl, backUrl, W (t.app.admin.leads.deal).
%>
<%- include('partials/head', { title: title + ' — sprzedamfakture.pl', noindex: true }) %>
<%- include('partials/nav') %>
<div class="wz-doc">
  <p class="no-print" style="display:flex; gap:10px; flex-wrap:wrap; margin:0 0 18px">
    <a class="btn chan-btn" href="<%= pdfUrl %>"><%= W.docs.pdf %></a>
    <button class="btn btn-secondary chan-btn" type="button" onclick="window.print()"><%= W.docs.print %></button>
    <a class="btn btn-ghost chan-btn" href="<%= backUrl %>"><%= W.docs.back %></a>
  </p>
  <% if (summary) { %><div class="no-print" style="background:var(--color-accent-100); border-radius:12px; padding:14px 16px; margin:0 0 22px; font-size:13.5px; line-height:1.55; white-space:pre-wrap"><strong><%= summaryLabel %></strong>
<%= summary %></div><% } %>
  <article class="deal-doc" style="font-size:14.5px; line-height:1.6">
  <% blocks.forEach(function (b) { %>
    <% if (b.type === 'title') { %><h1 style="font-size:22px; text-align:center; margin:10px 0 6px"><%= b.text %></h1>
    <% } else if (b.type === 'sub') { %><p style="text-align:center; color:var(--ink-55); font-size:13px; margin:0 0 18px"><%= b.text %></p>
    <% } else if (b.type === 'h') { %><h2 style="font-size:15.5px; margin:20px 0 6px"><%= b.text %></h2>
    <% } else if (b.type === 'p' || b.type === 'li') { %><p style="margin:0 0 8px; text-align:justify"><%= b.text %></p>
    <% } else if (b.type === 'small') { %><p style="font-size:12.5px; color:var(--ink-55); margin:0 0 8px"><%= b.text %></p>
    <% } else if (b.type === 'sig') { %><div class="wz-parties" style="display:flex; gap:40px; margin:40px 0 10px">
        <div style="flex:1"><div style="font-size:12px; color:var(--ink-55)"><%= b.leftLabel %></div><div style="margin-top:50px; border-top:1px solid #333; padding-top:6px; white-space:pre-wrap; font-size:13px"><%= b.left %><br><span style="color:var(--ink-55)">data, podpis</span></div></div>
        <div style="flex:1"><div style="font-size:12px; color:var(--ink-55)"><%= b.rightLabel %></div><div style="margin-top:50px; border-top:1px solid #333; padding-top:6px; white-space:pre-wrap; font-size:13px"><%= b.right %><br><span style="color:var(--ink-55)">data, podpis</span></div></div>
      </div>
    <% } else if (b.type === 'break') { %><hr style="page-break-after:always; border:0; border-top:1px dashed var(--color-divider); margin:34px 0">
    <% } %>
  <% }) %>
  </article>
</div>
<%- include('partials/footer') %>

<% var G = t.app.agent, fill = t.fill; %>
<%- include('partials/head', { title: t.app.titles.agent + ' — sprzedamfakture.pl' }) %>
<%- include('partials/nav') %>

<div class="agent-panes">
  <section class="agent-left">
    <div class="kicker"><%= G.monKicker %></div>
    <p class="helper"><%= G.monHelper %></p>
    <% if (!events.length) { %><p class="helper"><%= G.noEvents %></p><% } %>
    <% events.forEach(function(ev) { %>
    <div class="feed-row">
      <span class="time tnum"><%= new Date(ev.created_at).toLocaleTimeString(t.locale, {hour:'2-digit', minute:'2-digit'}) %></span>
      <span class="dot"></span>
      <span>
        <div class="fx"><span class="tag tag-outline" style="margin-right:8px"><%= t.tr(ev.type) %></span><%= t.tr(ev.title) %></div>
        <div class="fr2 tnum"><%= ev.debtor ? ev.debtor + " · " : "" %><%= t.tr(ev.source) %></div>
      </span>
    </div>
    <% }) %>

    <hr class="rule">
    <div class="kicker"><%= G.todayKicker %></div>
    <p class="helper"><%= G.todayHelper %></p>
    <% feed.forEach(function(f) { %>
    <div class="feed-row <%= f.planned ? 'planned' : '' %>">
      <span class="time tnum"><%= f.time %></span>
      <span class="dot"></span>
      <span>
        <div class="fx"><%= t.tr(f.text) %></div>
        <div class="fr2 tnum"><%= f.ref %></div>
      </span>
    </div>
    <% }) %>
  </section>

  <section class="agent-right">
    <div class="kicker"><%= G.negKicker %></div>

    <div class="label" style="margin-top:16px"><%= G.toneLabel %></div>
    <div class="tone-switch">
      <% TONES.forEach(function(tn) { %>
      <a href="/app/agent?ton=<%= tn %>" class="<%= tn === tone ? 'active' : '' %>"><%= t.app.tones[tn] || tn %></a>
      <% }) %>
    </div>

    <% thread.forEach(function(m) { %>
    <div class="msg <%= m.agent ? 'agent' : '' %>">
      <div class="who"><%= t.tr(m.label) %></div>
      <div class="body"><%= t.tr(m.text) %></div>
    </div>
    <% }) %>

    <hr class="rule">
    <div class="label"><%= G.rulesLabel %></div>
    <ul class="rules-list">
      <% G.rules.forEach(function(r, i) { %>
      <li><%- i === 0 ? fill(r, { tone: '<strong>' + (t.app.tones[tone] || tone) + '</strong>' }) : r %></li>
      <% }) %>
    </ul>
  </section>
</div>

<%- include('partials/footer') %>

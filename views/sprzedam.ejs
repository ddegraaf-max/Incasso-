<%
var h = t.home, c = t.common;
var errors = (typeof errors !== 'undefined' && errors) ? errors : {};
var form = (typeof form !== 'undefined' && form) ? form : {};
var hasErr = Object.keys(errors).length > 0;
var ld = [
  companyLd,
  { '@context': 'https://schema.org', '@type': 'Service', name: lang === 'en' ? 'Invoice purchase and B2B debt collection in Poland' : 'Skup faktur i wykup wierzytelności B2B', serviceType: lang === 'en' ? 'Purchase of receivables' : 'Wykup wierzytelności',
    provider: { '@type': 'Organization', name: 'sprzedamfakture.pl', url: 'https://sprzedamfakture.pl/' }, areaServed: { '@type': 'Country', name: 'Poland' }, url: 'https://sprzedamfakture.pl/', description: h.metaDesc, inLanguage: lang,
    offers: { '@type': 'Offer', priceCurrency: 'PLN', description: lang === 'en' ? 'Payout within 24 hours of signing the assignment; price as a percentage of face value after a free valuation.' : 'Wypłata w 24 godziny od podpisania cesji; cena jako procent wartości nominalnej po bezpłatnej wycenie.' } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: h.faq.items.filter(function (i) { return !(windykacjaOff && i[1].indexOf('/windykacja') !== -1); }).map(function (i) {
      return { '@type': 'Question', name: i[0], acceptedAnswer: { '@type': 'Answer', text: i[1].replace(/<[^>]+>/g, '').replace('{fee}', SERVICE_FEE) } };
    }) },
];
%><!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<%- include('partials/gads') %>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= h.metaTitle %></title>
<meta name="description" content="<%= h.metaDesc %>">
<link rel="canonical" href="https://sprzedamfakture.pl/<%= lang === 'en' ? '?lang=en' : '' %>">
<link rel="alternate" hreflang="pl" href="https://sprzedamfakture.pl/?lang=pl">
<link rel="alternate" hreflang="en" href="https://sprzedamfakture.pl/?lang=en">
<link rel="alternate" hreflang="x-default" href="https://sprzedamfakture.pl/">
<meta property="og:title" content="<%= h.metaTitle %>">
<meta property="og:description" content="<%= h.ogDesc %>">
<meta property="og:url" content="https://sprzedamfakture.pl/">
<meta property="og:locale" content="<%= lang === 'en' ? 'en_GB' : 'pl_PL' %>">
<%- include('partials/meta') %>
<link rel="preload" as="font" type="font/woff2" href="/fonts/manrope-latin.woff2" crossorigin>
<link rel="stylesheet" href="/css/app.css?v=<%= version %>">
<script type="application/ld+json"><%- JSON.stringify(ld).replace(/</g, '\\u003c') %></script>
</head>
<body class="sf">
<a class="skip-link" href="#main"><%= c.skip %></a>
<div style="min-height:100vh; display:flex; flex-direction:column">

<%- include('partials/nav') %>

<%
// Huisstijl v0.25: hero met kop, vertrouwenspunten, illustratie en de AI-wijzerkaart; daaronder de toolrij en "Jak to działa".
var H2 = h.hero2;
var E = est || (typeof exampleEst !== 'undefined' && exampleEst) || { amountLow: 0, amount: 0, pctLow: 0, pct: 0 };
var isEx = !est;
var I = {
  bolt: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7z"/></svg>',
  shield: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.5 8.5 8 9 4.5-.5 8-4 8-9V6z"/><path d="m9 12 2 2 4-4"/></svg>',
  laptop: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="12" rx="2"/><path d="M2 19h20"/></svg>',
  chip: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4"/><text x="12" y="14.6" text-anchor="middle" font-size="7" font-weight="800" fill="currentColor" stroke="none" font-family="Manrope, Arial, sans-serif">AI</text></svg>',
  calc: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8 7h8M8 12h2M12 12h2M16 12h.01M8 16h2M12 16h2M16 16h.01"/></svg>',
  demand: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5"/><path d="m9.5 15 2 2 3.5-4"/></svg>',
  limit: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/><path d="m9 15.5 2 2 4-4"/></svg>',
  gavel: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21l8-8"/><path d="M12 6l6 6"/><path d="M14 4l6 6"/><path d="M10 8l6 6"/></svg>',
  book: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h6a3 3 0 0 1 3 3v13a2 2 0 0 0-2-2H4z"/><path d="M20 4h-6a3 3 0 0 0-3 3v13a2 2 0 0 1 2-2h7z"/></svg>',
  faq: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.7.3-1 .9-1 1.7"/><path d="M12 17h.01"/></svg>',
  chev: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>',
  doc: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5M10 13h5M10 17h5"/></svg>',
  s1: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3h8l4 4v14H7z"/><path d="M15 3v4h4"/><path d="M12 18v-7M9.5 13.5 12 11l2.5 2.5"/></svg>',
  s3: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-8"/><path d="m16.5 3.5 3 3L13 13l-4 1 1-4z"/><path d="M8 17h5"/></svg>',
  s4: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="9" cy="6" rx="6" ry="2.5"/><path d="M3 6v4c0 1.4 2.7 2.5 6 2.5s6-1.1 6-2.5V6"/><path d="M3 10v4c0 1.4 2.7 2.5 6 2.5 1.1 0 2.1-.1 3-.4"/><path d="M12 15.5c0 1.4 2.7 2.5 6 2.5s6-1.1 6-2.5-2.7-2.5-6-2.5-6 1.1-6 2.5z"/><path d="M12 15.5V19c0 1.4 2.7 2.5 6 2.5s6-1.1 6-2.5v-3.5"/></svg>',
};
var stepIcons = [I.s1, I.chip, I.s3, I.s4];
%>
<section class="hero sf-hero" id="main">
  <canvas id="hero-net" aria-hidden="true"></canvas>
  <div class="hero-inner">
    <div class="hero-copy">
      <div class="hero-kicker"><%= H2.kicker %></div>
      <h1><%= H2.h1[0] %><br><%= H2.h1[1] %></h1>
      <p class="sub"><%= H2.sub %></p>
      <div class="cta">
        <a class="btn btn-arrow" href="#formularz"><%= H2.cta1 %></a>
        <a class="btn btn-secondary" href="#jak"><%= H2.cta2 %></a>
      </div>
      <div class="trust">
        <span><%- I.bolt %><%= H2.trust[0] %></span>
        <span><%- I.shield %><%= H2.trust[1] %></span>
        <span><%- I.laptop %><%= H2.trust[2] %></span>
      </div>
    </div>
    <div class="hero-art" aria-hidden="true">
      <svg viewBox="0 0 440 400" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="ha-teal" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#4fd6b8"/><stop offset="1" stop-color="#0e8a76"/></linearGradient>
          <linearGradient id="ha-sheet" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffffff"/><stop offset="1" stop-color="#eef6f4"/></linearGradient>
        </defs>
        <ellipse cx="220" cy="374" rx="172" ry="16" fill="rgba(18,36,61,0.08)"/>
        <ellipse cx="220" cy="352" rx="150" ry="26" fill="#d9e6e3"/>
        <ellipse cx="220" cy="345" rx="150" ry="26" fill="#eef4f3"/>
        <path d="M72 232c-22-72 30-142 108-162" fill="none" stroke="url(#ha-teal)" stroke-width="16" stroke-linecap="round"/>
        <path d="M168 52l22 18-28 10z" fill="#12a38b"/>
        <path d="M368 150c22 72-30 142-108 162" fill="none" stroke="url(#ha-teal)" stroke-width="16" stroke-linecap="round"/>
        <path d="M272 330l-22-18 28-10z" fill="#12a38b"/>
        <g transform="rotate(-7 220 180)"><rect x="150" y="66" width="150" height="200" rx="12" fill="#dfe9e7"/></g>
        <g transform="rotate(3 220 180)">
          <rect x="140" y="58" width="160" height="212" rx="12" fill="url(#ha-sheet)" stroke="#d2e0dd"/>
          <text x="162" y="98" font-family="Manrope, Arial, sans-serif" font-size="22" font-weight="800" fill="#12243d" letter-spacing="1"><%= lang === 'en' ? 'INVOICE' : 'FAKTURA' %></text>
          <rect x="162" y="114" width="90" height="8" rx="4" fill="#cfdedb"/><rect x="162" y="132" width="116" height="8" rx="4" fill="#dfe9e7"/><rect x="162" y="150" width="70" height="8" rx="4" fill="#dfe9e7"/><rect x="162" y="168" width="104" height="8" rx="4" fill="#dfe9e7"/>
          <rect x="162" y="198" width="116" height="10" rx="5" fill="#cfdedb"/><rect x="162" y="216" width="60" height="10" rx="5" fill="#12a38b" opacity=".85"/>
        </g>
        <circle cx="302" cy="98" r="26" fill="#12a38b" stroke="#fff" stroke-width="5"/>
        <path d="M289 98l9 9 17-18" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
        <rect x="76" y="248" width="204" height="76" rx="14" fill="#12243d"/>
        <circle cx="110" cy="286" r="18" fill="#12a38b"/>
        <path d="M101 286l6 6 12-13" fill="none" stroke="#fff" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
        <text x="140" y="281" font-family="Manrope, Arial, sans-serif" font-size="15" font-weight="800" fill="#fff"><%= H2.pay[0] %></text>
        <text x="140" y="302" font-family="Manrope, Arial, sans-serif" font-size="15" font-weight="800" fill="#5fe0c3"><%= H2.pay[1] %></text>
        <g>
          <ellipse cx="340" cy="322" rx="34" ry="12" fill="#9fb3c4"/><rect x="306" y="298" width="68" height="24" fill="#b8c9d6"/><ellipse cx="340" cy="298" rx="34" ry="12" fill="#d7e2ea"/>
          <ellipse cx="340" cy="284" rx="34" ry="12" fill="#9fb3c4"/><rect x="306" y="260" width="68" height="24" fill="#b8c9d6"/><ellipse cx="340" cy="260" rx="34" ry="12" fill="#d7e2ea"/>
          <ellipse cx="298" cy="336" rx="30" ry="10" fill="#9fb3c4"/><rect x="268" y="320" width="60" height="16" fill="#b8c9d6"/><ellipse cx="298" cy="320" rx="30" ry="10" fill="#d7e2ea"/>
        </g>
      </svg>
    </div>
    <div class="qcard" id="wycena">
      <div class="qcard-head">
        <div class="ai"><%- I.chip %></div>
        <div><h2><%= H2.quote.title %></h2><p><%= H2.quote.sub %></p></div>
      </div>
      <div class="qcard-body">
        <form method="get" action="/#wycena" id="wycena-form">
          <div class="qgrid">
            <div class="qfield"><label for="w-kwota"><%= h.quote.labelAmount %></label><input class="tnum" type="text" id="w-kwota" name="kwota" inputmode="decimal" placeholder="<%= h.quote.phAmount %>" value="<%= q.kwota || '12 400' %>" autocomplete="off" required></div>
            <div class="qfield"><label for="w-dni"><%= h.quote.labelDays %></label><input class="tnum" type="number" id="w-dni" name="dni" min="1" max="3650" placeholder="<%= h.quote.phDays %>" value="<%= q.dni || '30' %>" autocomplete="off" required></div>
          </div>
          <button class="btn btn-arrow" type="submit"><%= h.quote.btn %></button>
        </form>
        <div class="qresult-wrap" id="wycena-live" aria-live="polite">
          <div class="qresult">
            <div><div class="ql"><%= H2.quote.offer %></div><div class="qv swr-main"><span class="tnum"><%= D.fmt(E.amountLow) %> – <%= D.fmt(E.amount) %></span></div></div>
            <div class="sep"></div>
            <div><div class="ql"><%= H2.quote.pct %></div><div class="qv pct"><span class="tnum" id="swr-pct"><%= E.pctLow %>–<%= E.pct %>%</span></div></div>
          </div>
          <p class="qexample" id="swr-example"<%- isEx ? '' : ' hidden' %>><%- I.doc %><span><%- H2.quote.example.replace('{amount}', '<strong>12 400 zł</strong>').replace('{days}', '30') %></span></p>
          <p class="swr-sub" data-tpl="<%= h.quote.resultSub %>"><%= h.quote.resultSub.replace('{low}', E.pctLow).replace('{high}', E.pct) %></p>
          <a class="btn btn-secondary qcta" href="#formularz"><%= h.quote.resultCta %></a>
        </div>
      </div>
    </div>
  </div>
</section>

<nav class="sf-tools" aria-label="<%= c.navTools %>">
  <% H2.tools.forEach(function (tl) { %><a class="tool" href="<%= tl[0] %>"><span class="ico"><%- I[tl[2]] %></span><span><%= tl[1] %></span><span class="chev"><%- I.chev %></span></a><% }) %>
</nav>

<% if (h.liveStrip) { %>
<section class="live-strip" aria-label="<%= h.liveStrip.kicker %>">
  <div class="live-strip-inner">
    <div>
      <div class="kicker"><%= h.liveStrip.kicker %></div>
      <p><strong><%= h.liveStrip.strong %></strong> — <%= h.liveStrip.text %></p>
    </div>
    <a class="btn btn-live" href="/wezwanie-online"><%= h.liveStrip.btn %> <span class="live-badge"><%= h.liveStrip.badge %></span></a>
  </div>
</section>
<% } %>

<section class="steps4" id="jak">
  <div class="steps4-inner">
    <div class="steps4-intro"><h2><%= H2.steps.title %></h2><p class="lead"><%= H2.steps.sub %></p></div>
    <% H2.steps.items.forEach(function (st, i) { %>
    <div class="step"><span class="n tnum"><%= i + 1 %></span><div class="ico"><%- stepIcons[i] %></div><h3><%= st[0] %></h3><p><%= st[1] %></p></div>
    <% }) %>
  </div>
</section>

<% var HG = h.hourglass; var hgDni = parseInt(q.dni, 10) > 0 ? parseInt(q.dni, 10) : null; var hg = D.przedawnienie(hgDni || 45, 2); var hgExample = !hgDni; var hgH = 93; %>
<section class="hg-wrap" id="przedawnienie">
  <div class="hg-grid">
    <div class="hg-copy">
      <div class="kicker"><%= HG.kicker %></div>
      <h2><%= HG.h %></h2>
      <p><%= HG.sub %></p>
      <p class="hg-note"><%= HG.note %></p>
      <a class="btn" href="#formularz"><%= HG.cta %></a>
    </div>
    <div class="hg-panel<%= hg.expired || hg.fraction < 0.2 ? ' hg-danger' : '' %>">
      <svg class="hg-svg" viewBox="0 0 160 220" aria-hidden="true">
        <clipPath id="hg-top-clip"><path d="M42 18c0 38 21 59 33 75 3 4 7 4 10 0 12-16 33-37 33-75z"/></clipPath>
        <clipPath id="hg-bot-clip"><path d="M42 206c0-38 21-59 33-75 3-4 7-4 10 0 12 16 33 37 33 75z"/></clipPath>
        <rect id="hg-sand-top" class="hg-sand" x="40" width="80" clip-path="url(#hg-top-clip)" y="<%= (111 - hg.fraction * hgH).toFixed(1) %>" height="<%= (hg.fraction * hgH).toFixed(1) %>"/>
        <rect id="hg-sand-bottom" class="hg-sand" x="40" width="80" clip-path="url(#hg-bot-clip)" y="<%= (206 - (1 - hg.fraction) * hgH).toFixed(1) %>" height="<%= ((1 - hg.fraction) * hgH).toFixed(1) %>"/>
        <line id="hg-stream" class="hg-stream" x1="80" y1="110" x2="80" y2="200"<%- hg.expired || hg.fraction <= 0 || hg.fraction >= 1 ? ' style="display:none"' : '' %>/>
        <path class="hg-frame" d="M30 12h100M30 208h100M40 16c0 40 22 62 34 78 4 5 4 9 0 14-12 16-34 38-34 76M120 16c0 40-22 62-34 78-4 5-4 9 0 14 12 16 34 38 34 76" fill="none"/>
      </svg>
      <label class="hg-type-label" for="hg-type"><%= HG.typeLabel %></label>
      <select id="hg-type" class="chan-tone">
        <% HG.types.forEach(function (o) { %><option value="<%= o[0] %>" <%= o[0] === '2' ? 'selected' : '' %>><%= o[1] %></option><% }) %>
      </select>
      <div class="hg-read" id="hg-read" data-result="<%= HG.result %>" data-left="<%= HG.left %>" data-used="<%= HG.usedTpl %>" data-expired="<%= HG.expired %>" data-example="<%= HG.example %>" aria-live="polite">
        <div class="hg-date tnum" id="hg-date"><%= HG.result.replace('{date}', hg.endFmt) %></div>
        <div class="hg-left tnum" id="hg-left"><%= hg.expired ? '' : HG.left.replace('{days}', hg.daysLeft) + ' · ' + HG.usedTpl.replace('{pct}', Math.round((1 - hg.fraction) * 100)) %></div>
        <div class="hg-msg" id="hg-msg"><%= hg.expired ? HG.expired : (hgExample ? HG.example.replace('{days}', hgDni || 45) : '') %></div>
      </div>
    </div>
  </div>
</section>

<section class="model">
  <div class="kicker"><%= h.why.kicker %></div>
  <div class="model-grid">
    <% h.why.items.forEach(function (w, i) { %>
    <div class="cell <%= i === 2 ? 'alt' : '' %>"><div class="m-who"><%= w[0] %></div><h3><%= w[1] %></h3><p><%= w[2] %></p></div>
    <% }) %>
  </div>
</section>

<% if (h.wyrokTeaser) { %>
<section class="wyrok-teaser-wrap">
  <div class="wyrok-teaser">
    <div>
      <div class="kicker"><%= h.wyrokTeaser.kicker %></div>
      <h2><%= h.wyrokTeaser.h %></h2>
      <p><%= h.wyrokTeaser.p %></p>
    </div>
    <a class="btn btn-gold" href="/skup-wyrokow"><%= h.wyrokTeaser.cta %></a>
  </div>
</section>
<% } %>

<% if (h.kbTeaser && typeof kbArticles !== 'undefined' && kbArticles.length) { %>
<section class="kb-teaser-wrap" id="baza-wiedzy">
  <div class="kicker"><%= h.kbTeaser.kicker %></div>
  <h2><%= h.kbTeaser.h %></h2>
  <div class="kb-list">
    <% kbArticles.forEach(function (a) { var x = a[lang === 'en' ? 'en' : 'pl']; %>
    <a class="kb-card" href="/baza-wiedzy/<%= a.slug %>"><h3><%= x.seoTitle || x.title %></h3><p><%= x.desc %></p><span class="kb-more"><%= h.kbTeaser.more %></span></a>
    <% }) %>
  </div>
  <p style="margin:18px 0 0"><a class="btn btn-secondary" href="/baza-wiedzy"><%= h.kbTeaser.all %></a></p>
</section>
<% } %>

<section class="why" id="faq">
  <div class="why-grid">
    <div class="cell">
      <div class="kicker"><%= h.faq.kicker %></div>
      <h2><%= h.faq.h %></h2>
      <div class="sf-faq">
        <% h.faq.items.filter(function (f) { return !(windykacjaOff && f[1].indexOf('/windykacja') !== -1); }).forEach(function (f) { %>
        <div class="sf-q"><%= f[0] %></div>
        <div class="sf-a"><%- f[1].replace('{fee}', SERVICE_FEE) %></div>
        <% }) %>
      </div>
    </div>
    <div class="cell">
      <div class="kicker" id="formularz"><%= h.form.kicker %></div>
      <% if (leadOk) { %>
      <div class="confirm"><span class="sq"></span><span><%= h.form.ok %></span></div>
      <% } else { %>
      <form class="calc-form" method="post" action="/sprzedaj" id="lead-form" enctype="multipart/form-data">
        <% if (hasErr) { %><div class="form-error" role="alert"><%= h.form.errors.generic %></div><% } %>
        <div class="fg<%= errors.company ? ' has-err' : '' %>">
          <label for="f-firma"><%= h.form.company %></label>
          <input type="text" id="f-firma" name="company" value="<%= form.company || '' %>" autocomplete="organization" required<%- errors.company ? ' aria-invalid="true"' : '' %>>
          <% if (errors.company) { %><div class="field-err"><%= errors.company %></div><% } %>
        </div>
        <div class="fg<%= errors.nip ? ' has-err' : '' %>">
          <label for="f-nip"><%= h.form.nip %></label>
          <input type="text" id="f-nip" name="nip" class="tnum" inputmode="numeric" value="<%= form.nip || '' %>" placeholder="5210000000" required<%- errors.nip ? ' aria-invalid="true"' : '' %>>
          <% if (errors.nip) { %><div class="field-err"><%= errors.nip %></div><% } %>
        </div>
        <div class="fg<%= errors.forma ? ' has-err' : '' %>">
          <label for="f-forma"><%= h.form.forma %></label>
          <select id="f-forma" name="forma" required<%- errors.forma ? ' aria-invalid="true"' : '' %>>
            <option value="" disabled <%= form.forma ? '' : 'selected' %>><%= h.form.formaPh %></option>
            <% h.form.formaOptions.forEach(function (o) { %><option value="<%= o[0] %>" <%= form.forma === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %>
          </select>
          <% if (errors.forma) { %><div class="field-err"><%= errors.forma %></div><% } else { %><p class="legal-note" style="margin-top:6px"><%= h.form.formaNote %></p><% } %>
        </div>
        <div class="fg<%= errors.kwota ? ' has-err' : '' %>">
          <label for="f-kwota"><%= h.form.amount %></label>
          <input type="text" id="f-kwota" name="kwota" class="tnum" inputmode="decimal" value="<%= form.kwota || '' %>" required<%- errors.kwota ? ' aria-invalid="true"' : '' %>>
          <% if (errors.kwota) { %><div class="field-err"><%= errors.kwota %></div><% } %>
        </div>
        <div class="fg<%= errors.dni ? ' has-err' : '' %>">
          <label for="f-dni"><%= h.form.days %></label>
          <input type="number" id="f-dni" name="dni" class="tnum" min="1" max="3650" value="<%= form.dni || '' %>" required<%- errors.dni ? ' aria-invalid="true"' : '' %>>
          <% if (errors.dni) { %><div class="field-err"><%= errors.dni %></div><% } %>
        </div>
        <div class="fg<%= errors.email ? ' has-err' : '' %>">
          <label for="f-email"><%= h.form.email %></label>
          <input type="email" id="f-email" name="email" value="<%= form.email || '' %>" autocomplete="email" required<%- errors.email ? ' aria-invalid="true"' : '' %>>
          <% if (errors.email) { %><div class="field-err"><%= errors.email %></div><% } %>
        </div>
        <div class="fg<%= errors.tel ? ' has-err' : '' %>">
          <label for="f-tel"><%= h.form.tel %></label>
          <input type="tel" id="f-tel" name="tel" class="tnum" value="<%= form.tel || '' %>" autocomplete="tel" required<%- errors.tel ? ' aria-invalid="true"' : '' %>>
          <% if (errors.tel) { %><div class="field-err"><%= errors.tel %></div><% } %>
        </div>
        <div class="fg<%= errors.zalacznik ? ' has-err' : '' %>">
          <label for="f-zal"><%= h.form.zalacznik %></label>
          <input type="file" id="f-zal" name="zalacznik" accept=".pdf,.jpg,.jpeg,.png,.xml">
          <% if (errors.zalacznik) { %><div class="field-err"><%= errors.zalacznik %></div><% } else { %><p class="legal-note" style="margin-top:6px"><%= h.form.zalacznikNote %></p><% } %>
        </div>
        <div class="hp" aria-hidden="true"><label for="f-web">Website</label><input type="text" id="f-web" name="website" tabindex="-1" autocomplete="off"></div>
        <% if ((turnstile && turnstile.enabled) || errors.captcha) { %>
        <div class="fg<%= errors.captcha ? ' has-err' : '' %>">
          <%- include('partials/turnstile') %>
          <% if (errors.captcha) { %><div class="field-err"><%= errors.captcha %></div><% } %>
        </div>
        <% } %>
        <button class="btn btn-gold" type="submit"><%= h.form.btn %></button>
        <p class="legal-note" style="margin-top:12px"><%= h.form.note %></p>
      
      <p class="helper legal-note" style="font-size:12.5px;margin-top:10px"><%- lang === 'en' ? 'By sending the form you accept the <a href="/regulamin">Terms</a>. How we process data, including the debtor\'s data: <a href="/polityka-prywatnosci">Privacy policy</a> (in Polish).' : 'Wysyłając formularz, akceptujesz <a href="/regulamin">Regulamin</a>. Informacje o przetwarzaniu danych, także danych dłużnika: <a href="/polityka-prywatnosci">Polityka prywatności</a>.' %></p>
</form>
      <% } %>
    </div>
  </div>
</section>

<footer class="sources" id="kontakt">
  <div class="wrap">
    <div class="sf-footer">
      <%- include('partials/logo', { size: 'sm', tagline: true }) %>
      <span class="sf-footer-links"><% if (!windykacjaOff) { %><a href="/windykacja"><%= h.footer.collection %></a> · <% } %><a href="/kalkulator"><%= h.footer.calc %></a> · <a href="/skup-wyrokow"><%= t.common.footJudgments %></a> · <a href="/login"><%= h.footer.panel %></a> · <a href="/regulamin"><%= lang === 'en' ? 'Terms (PL)' : 'Regulamin' %></a> · <a href="/polityka-prywatnosci"><%= lang === 'en' ? 'Privacy policy (PL)' : 'Polityka prywatności' %></a></span>
    </div>
    <div class="cr"><%= h.footer.legal %> · <span class="ver tnum" title="<%= c.versionTitle %>">v<%= version %><%= commit ? ' · ' + commit : '' %></span></div>
  </div>
</footer>
<%- include('partials/company') %>

</div>
<script src="/js/motion.js?v=<%= version %>" defer></script>
<script src="/js/wycena.js?v=<%= version %>" defer></script>
<script src="/js/nip.js?v=<%= version %>" defer></script>
</body>
</html>

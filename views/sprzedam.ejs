<%
var h = t.home, c = t.common;
var errors = (typeof errors !== 'undefined' && errors) ? errors : {};
var form = (typeof form !== 'undefined' && form) ? form : {};
var hasErr = Object.keys(errors).length > 0;
var ld = [
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'sprzedamfakture.pl', url: 'https://sprzedamfakture.pl/', logo: 'https://sprzedamfakture.pl/img/logo.svg', email: 'kontakt@sprzedamfakture.pl' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: h.faq.items.map(function (i) {
      return { '@type': 'Question', name: i[0], acceptedAnswer: { '@type': 'Answer', text: i[1].replace(/<[^>]+>/g, '').replace('{fee}', SERVICE_FEE) } };
    }) },
];
%><!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= h.metaTitle %></title>
<meta name="description" content="<%= h.metaDesc %>">
<link rel="canonical" href="https://sprzedamfakture.pl/<%= lang === 'en' ? '?lang=en' : '' %>">
<link rel="alternate" hreflang="pl" href="https://sprzedamfakture.pl/?lang=pl">
<link rel="alternate" hreflang="en" href="https://sprzedamfakture.pl/?lang=en">
<link rel="alternate" hreflang="x-default" href="https://sprzedamfakture.pl/">
<meta property="og:title" content="<%= h.metaTitle %>">
<meta property="og:description" content="<%= h.ogDesc %>">
<meta property="og:url" content="https://sprzedamfakture.pl/">
<meta property="og:locale" content="<%= lang === 'en' ? 'en_GB' : 'pl_PL' %>">
<%- include('partials/meta') %>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="/css/app.css?v=<%= version %>">
<script type="application/ld+json"><%- JSON.stringify(ld).replace(/</g, '\\u003c') %></script>
</head>
<body class="sf">
<a class="skip-link" href="#main"><%= c.skip %></a>
<div style="min-height:100vh; display:flex; flex-direction:column">

<nav class="nav">
  <%- include('partials/logo', { tagline: true }) %>
  <span class="nav-right nav-links">
    <a href="#jak"><%= h.nav.how %></a>
    <a href="#wycena"><%= h.nav.quote %></a>
    <a href="#faq"><%= h.nav.faq %></a>
    <% if (!windykacjaOff) { %><a href="/windykacja"><%= h.nav.collection %></a><% } %>
    <a href="/skup-wyrokow"><%= t.common.navJudgments %></a>
    <a href="/login"><%= h.nav.panel %></a>
    <a href="#formularz" class="nav-cta"><%= h.nav.cta %></a>
    <span class="lang-switch">
      <a href="<%= langUrl('pl') %>" class="<%= lang === 'pl' ? 'active' : '' %>" hreflang="pl">PL</a><span class="sep">·</span><a href="<%= langUrl('en') %>" class="<%= lang === 'en' ? 'active' : '' %>" hreflang="en">EN</a>
    </span>
  </span>
</nav>

<section class="hero sf-hero" id="main">
  <canvas id="hero-net" aria-hidden="true"></canvas>
  <div class="hero-inner">
    <div class="hero-copy">
      <h1><%= h.heroH1[0] %><br><%= h.heroH1[1] %></h1>
      <p class="sub"><%= h.heroSub %></p>
      <div class="cta">
        <a class="btn" href="#wycena"><%= h.ctaQuote %></a>
        <a class="btn btn-secondary" href="#jak"><%= h.ctaHow %></a>
      </div>
    </div>
    <div class="hero-visual" aria-hidden="true">
      <div class="hero-card">
        <div class="hc-top">
          <%- include('partials/logo', { size: 'sm', asLink: false }) %>
          <span class="hc-seal tnum"><%= h.card.seal %></span>
        </div>
        <div class="hc-title"><%= h.card.title %></div>
        <div class="hc-row"><span><%= h.card.invoice %></span><span class="tnum">12 400 zł</span></div>
        <div class="hc-row"><span><%= h.card.overdue %></span><span class="tnum"><%= h.card.score %></span></div>
        <div class="hc-row hc-total"><span><%= h.card.offer %></span><span class="tnum">9 424 zł</span></div>
        <div class="hc-bar"><span class="hc-fill"></span></div>
        <div class="hc-foot"><%= h.card.foot %></div>
      </div>
      <div class="hero-chip hc-a tnum"><%= h.card.chipA %></div>
      <div class="hero-chip hc-b"><%= h.card.chipB %></div>
    </div>
  </div>
</section>

<section class="path" id="jak">
  <div class="kicker"><%= h.steps.kicker %></div>
  <div class="path-grid">
    <% h.steps.items.forEach(function (s) { %>
    <div class="cell"><div class="p-step tnum"><%= s[0] %></div><div class="p-desc"><%= s[1] %></div></div>
    <% }) %>
  </div>
</section>

<section class="law" id="wycena">
  <div class="wrap">
    <div class="kicker"><%= h.quote.kicker %></div>
    <div class="sf-wycena">
      <form method="get" action="/#wycena" class="sf-wycena-form" id="wycena-form">
        <div>
          <label for="w-kwota"><%= h.quote.labelAmount %></label>
          <input class="tnum" type="text" id="w-kwota" name="kwota" inputmode="decimal" placeholder="<%= h.quote.phAmount %>" value="<%= q.kwota %>" autocomplete="off" required>
        </div>
        <div>
          <label for="w-dni"><%= h.quote.labelDays %></label>
          <input class="tnum" type="number" id="w-dni" name="dni" min="1" max="3650" placeholder="<%= h.quote.phDays %>" value="<%= q.dni %>" autocomplete="off" required>
        </div>
        <button class="btn btn-gold" type="submit"><%= h.quote.btn %></button>
      </form>
      <div class="sf-wycena-result" id="wycena-live" aria-live="polite"<%- est ? '' : ' hidden' %>>
        <div class="swr-main"><span class="tnum"><%= est ? D.fmt(est.amountLow) + ' – ' + D.fmt(est.amount) : '' %></span></div>
        <div class="swr-sub" data-tpl="<%= h.quote.resultSub %>"><%= est ? h.quote.resultSub.replace('{low}', est.pctLow).replace('{high}', est.pct) : '' %></div>
        <a class="btn btn-gold" href="#formularz"><%= h.quote.resultCta %></a>
      </div>
      <p class="sf-wycena-hint"><%= h.quote.hint %></p>
    </div>
  </div>
</section>

<% var HG = h.hourglass; var hgDni = parseInt(q.dni, 10) > 0 ? parseInt(q.dni, 10) : null; var hg = D.przedawnienie(hgDni || 45, 2); var hgExample = !hgDni; var hgH = 93; %>
<section class="hg-wrap" id="przedawnienie">
  <div class="hg-grid">
    <div class="hg-copy">
      <div class="kicker"><%= HG.kicker %></div>
      <h2><%= HG.h %></h2>
      <p><%= HG.sub %></p>
      <p class="hg-note"><%= HG.note %></p>
      <a class="btn" href="#formularz"><%= HG.cta %></a>
    </div>
    <div class="hg-panel<%= hg.expired || hg.fraction < 0.2 ? ' hg-danger' : '' %>">
      <svg class="hg-svg" viewBox="0 0 160 220" aria-hidden="true">
        <clipPath id="hg-top-clip"><path d="M42 18c0 38 21 59 33 75 3 4 7 4 10 0 12-16 33-37 33-75z"/></clipPath>
        <clipPath id="hg-bot-clip"><path d="M42 206c0-38 21-59 33-75 3-4 7-4 10 0 12 16 33 37 33 75z"/></clipPath>
        <rect id="hg-sand-top" class="hg-sand" x="40" width="80" clip-path="url(#hg-top-clip)" y="<%= (111 - hg.fraction * hgH).toFixed(1) %>" height="<%= (hg.fraction * hgH).toFixed(1) %>"/>
        <rect id="hg-sand-bottom" class="hg-sand" x="40" width="80" clip-path="url(#hg-bot-clip)" y="<%= (206 - (1 - hg.fraction) * hgH).toFixed(1) %>" height="<%= ((1 - hg.fraction) * hgH).toFixed(1) %>"/>
        <line id="hg-stream" class="hg-stream" x1="80" y1="110" x2="80" y2="200"<%- hg.expired || hg.fraction <= 0 || hg.fraction >= 1 ? ' style="display:none"' : '' %>/>
        <path class="hg-frame" d="M30 12h100M30 208h100M40 16c0 40 22 62 34 78 4 5 4 9 0 14-12 16-34 38-34 76M120 16c0 40-22 62-34 78-4 5-4 9 0 14 12 16 34 38 34 76" fill="none"/>
      </svg>
      <label class="hg-type-label" for="hg-type"><%= HG.typeLabel %></label>
      <select id="hg-type" class="chan-tone">
        <% HG.types.forEach(function (o) { %><option value="<%= o[0] %>" <%= o[0] === '2' ? 'selected' : '' %>><%= o[1] %></option><% }) %>
      </select>
      <div class="hg-read" id="hg-read" data-result="<%= HG.result %>" data-left="<%= HG.left %>" data-used="<%= HG.usedTpl %>" data-expired="<%= HG.expired %>" data-example="<%= HG.example %>" aria-live="polite">
        <div class="hg-date tnum" id="hg-date"><%= HG.result.replace('{date}', hg.endFmt) %></div>
        <div class="hg-left tnum" id="hg-left"><%= hg.expired ? '' : HG.left.replace('{days}', hg.daysLeft) + ' · ' + HG.usedTpl.replace('{pct}', Math.round((1 - hg.fraction) * 100)) %></div>
        <div class="hg-msg" id="hg-msg"><%= hg.expired ? HG.expired : (hgExample ? HG.example.replace('{days}', hgDni || 45) : '') %></div>
      </div>
    </div>
  </div>
</section>

<section class="model">
  <div class="kicker"><%= h.why.kicker %></div>
  <div class="model-grid">
    <% h.why.items.forEach(function (w, i) { %>
    <div class="cell <%= i === 2 ? 'alt' : '' %>"><div class="m-who"><%= w[0] %></div><h4><%= w[1] %></h4><p><%= w[2] %></p></div>
    <% }) %>
  </div>
</section>

<section class="why" id="faq">
  <div class="why-grid">
    <div class="cell">
      <div class="kicker"><%= h.faq.kicker %></div>
      <h2><%= h.faq.h %></h2>
      <div class="sf-faq">
        <% h.faq.items.filter(function (f) { return !(windykacjaOff && f[1].indexOf('/windykacja') !== -1); }).forEach(function (f) { %>
        <div class="sf-q"><%= f[0] %></div>
        <div class="sf-a"><%- f[1].replace('{fee}', SERVICE_FEE) %></div>
        <% }) %>
      </div>
    </div>
    <div class="cell">
      <div class="kicker" id="formularz"><%= h.form.kicker %></div>
      <% if (leadOk) { %>
      <div class="confirm"><span class="sq"></span><span><%= h.form.ok %></span></div>
      <% } else { %>
      <form class="calc-form" method="post" action="/sprzedaj" id="lead-form">
        <% if (hasErr) { %><div class="form-error" role="alert"><%= h.form.errors.generic %></div><% } %>
        <div class="fg<%= errors.company ? ' has-err' : '' %>">
          <label for="f-firma"><%= h.form.company %></label>
          <input type="text" id="f-firma" name="company" value="<%= form.company || '' %>" autocomplete="organization" required<%- errors.company ? ' aria-invalid="true"' : '' %>>
          <% if (errors.company) { %><div class="field-err"><%= errors.company %></div><% } %>
        </div>
        <div class="fg<%= errors.nip ? ' has-err' : '' %>">
          <label for="f-nip"><%= h.form.nip %></label>
          <input type="text" id="f-nip" name="nip" class="tnum" inputmode="numeric" value="<%= form.nip || '' %>" placeholder="5210000000" required<%- errors.nip ? ' aria-invalid="true"' : '' %>>
          <% if (errors.nip) { %><div class="field-err"><%= errors.nip %></div><% } %>
        </div>
        <div class="fg<%= errors.forma ? ' has-err' : '' %>">
          <label for="f-forma"><%= h.form.forma %></label>
          <select id="f-forma" name="forma" required<%- errors.forma ? ' aria-invalid="true"' : '' %>>
            <option value="" disabled <%= form.forma ? '' : 'selected' %>><%= h.form.formaPh %></option>
            <% h.form.formaOptions.forEach(function (o) { %><option value="<%= o[0] %>" <%= form.forma === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %>
          </select>
          <% if (errors.forma) { %><div class="field-err"><%= errors.forma %></div><% } else { %><p class="legal-note" style="margin-top:6px"><%= h.form.formaNote %></p><% } %>
        </div>
        <div class="fg<%= errors.kwota ? ' has-err' : '' %>">
          <label for="f-kwota"><%= h.form.amount %></label>
          <input type="text" id="f-kwota" name="kwota" class="tnum" inputmode="decimal" value="<%= form.kwota || '' %>" required<%- errors.kwota ? ' aria-invalid="true"' : '' %>>
          <% if (errors.kwota) { %><div class="field-err"><%= errors.kwota %></div><% } %>
        </div>
        <div class="fg<%= errors.dni ? ' has-err' : '' %>">
          <label for="f-dni"><%= h.form.days %></label>
          <input type="number" id="f-dni" name="dni" class="tnum" min="1" max="3650" value="<%= form.dni || '' %>" required<%- errors.dni ? ' aria-invalid="true"' : '' %>>
          <% if (errors.dni) { %><div class="field-err"><%= errors.dni %></div><% } %>
        </div>
        <div class="fg<%= errors.email ? ' has-err' : '' %>">
          <label for="f-email"><%= h.form.email %></label>
          <input type="email" id="f-email" name="email" value="<%= form.email || '' %>" autocomplete="email" required<%- errors.email ? ' aria-invalid="true"' : '' %>>
          <% if (errors.email) { %><div class="field-err"><%= errors.email %></div><% } %>
        </div>
        <div class="fg<%= errors.tel ? ' has-err' : '' %>">
          <label for="f-tel"><%= h.form.tel %></label>
          <input type="tel" id="f-tel" name="tel" class="tnum" value="<%= form.tel || '' %>" autocomplete="tel" required<%- errors.tel ? ' aria-invalid="true"' : '' %>>
          <% if (errors.tel) { %><div class="field-err"><%= errors.tel %></div><% } %>
        </div>
        <div class="hp" aria-hidden="true"><label for="f-web">Website</label><input type="text" id="f-web" name="website" tabindex="-1" autocomplete="off"></div>
        <% if ((turnstile && turnstile.enabled) || errors.captcha) { %>
        <div class="fg<%= errors.captcha ? ' has-err' : '' %>">
          <%- include('partials/turnstile') %>
          <% if (errors.captcha) { %><div class="field-err"><%= errors.captcha %></div><% } %>
        </div>
        <% } %>
        <button class="btn btn-gold" type="submit"><%= h.form.btn %></button>
        <p class="legal-note" style="margin-top:12px"><%= h.form.note %></p>
      </form>
      <% } %>
    </div>
  </div>
</section>

<footer class="sources">
  <div class="wrap">
    <div class="sf-footer">
      <%- include('partials/logo', { size: 'sm', tagline: true }) %>
      <span class="sf-footer-links"><% if (!windykacjaOff) { %><a href="/windykacja"><%= h.footer.collection %></a> · <% } %><a href="/kalkulator"><%= h.footer.calc %></a> · <a href="/skup-wyrokow"><%= t.common.footJudgments %></a> · <a href="/login"><%= h.footer.panel %></a></span>
    </div>
    <div class="cr"><%= h.footer.legal %> · <span class="ver tnum" title="<%= c.versionTitle %>">v<%= version %><%= commit ? ' · ' + commit : '' %></span></div>
  </div>
</footer>

</div>
<script src="/js/motion.js?v=<%= version %>" defer></script>
<script src="/js/wycena.js?v=<%= version %>" defer></script>
</body>
</html>

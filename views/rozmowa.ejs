<% var Z = t.app.rozmowa, fill = t.fill; %>
<%- include('partials/head', { title: t.app.titles.rozmowa + ' — ' + c.debtor + ' — sprzedamfakture.pl' }) %>
<%- include('partials/nav') %>

<div class="two-pane" style="flex:1">
  <div class="pane-left">
    <div class="kicker"><%= fill(Z.kicker, { nr: c.nr, score: c.ai.score }) %></div>
    <h2 style="font-size:26px"><%= c.debtor %></h2>
    <p class="meta tnum" style="color:var(--ink-70); font-size:13.5px"><%= fill(Z.meta, { amount: D.fmt(c.amount), days: t.app.days(c.days), interest: D.fmt(D.interest(c.amount, c.days)), rekomp: D.fmt(D.rekompZl(c.amount)) }) %></p>

    <a class="tel-big tnum" href="tel:<%= c.tel.replace(/\s/g,'') %>"><%= c.tel %></a>
    <% if (Z.scriptNote) { %><p class="helper" style="margin-top:10px"><%= Z.scriptNote %></p><% } %>

    <hr class="rule">
    <div class="label"><%= Z.goal %></div>
    <p style="font-size:14.5px; font-weight:600; max-width:60ch" lang="pl"><%= script.cel %></p>

    <div class="label" style="margin-top:18px"><%= Z.opening %></div>
    <p class="script-line" lang="pl"><%= script.otwarcie %></p>

    <div class="label" style="margin-top:18px"><%= Z.args %></div>
    <% script.argumenty.forEach(function(a) { %>
    <div class="dot-row" lang="pl"><span class="dot"></span><span><%= a %></span></div>
    <% }) %>

    <div class="label" style="margin-top:18px"><%= Z.objections %></div>
    <% script.wymowki.forEach(function(w) { %>
    <div class="wymowka" lang="pl">
      <div class="w-q"><%= w[0] %></div>
      <div class="w-a"><%= w[1] %></div>
    </div>
    <% }) %>

    <div class="label" style="margin-top:18px"><%= Z.closing %></div>
    <p class="script-line" lang="pl"><%= script.zamkniecie %></p>
  </div>

  <aside class="pane-right">
    <div class="kicker"><%= Z.resultKicker %></div>
    <p class="helper"><%= Z.resultHelper %></p>

    <form class="calc-form" method="post" action="/app/sprawy/<%= c.id %>/rozmowa">
      <div class="fg">
        <label for="wynik"><%= Z.outcome %></label>
        <select id="wynik" name="wynik" required>
          <% Object.keys(OUTCOMES).forEach(function(k) { %>
          <option value="<%= k %>"><%= t.app.outcomes[k] || OUTCOMES[k] %></option>
          <% }) %>
        </select>
      </div>
      <div class="fg">
        <label for="termin"><%= Z.promised %></label>
        <input type="date" id="termin" name="termin" class="tnum">
      </div>
      <div class="fg">
        <label for="notatka"><%= Z.note %></label>
        <textarea id="notatka" name="notatka" rows="4" placeholder="<%= Z.notePh %>"></textarea>
      </div>
      <button class="btn" type="submit"><%= Z.save %></button>
    </form>

    <p style="font-size:13.5px"><a href="/app/sprawy?sel=<%= c.id %>"><%= Z.back %></a></p>
  </aside>
</div>

<%- include('partials/footer') %>

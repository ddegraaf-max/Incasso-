<% var M = t.app.admin, L = M.leads, R = t.app.sprawy.real, fill = t.fill;
   var stTag = function(s) { return (!s || s === 'nowy' || s === 'zaakceptowany') ? 'tag-accent' : (s === 'kontakt' || s === 'oferta') ? 'tag-outline' : 'tag-neutral'; };
   var stTxt = function(s) { return L.statuses[s] || s || L.statuses.nowy; };
   var src = function(l) { return l.source === 'skup-wyrokow' ? L.srcWyrok : L.srcInvoice; };
   var dateFmt = function(d) { return new Date(d).toLocaleString(t.locale, { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }); };
%>
<%- include('partials/head', { title: t.app.titles.leads + ' — sprzedamfakture.pl', autoRefresh: (typeof researchPending !== 'undefined' && researchPending) ? 12 : 0 }) %>
<%- include('partials/nav') %>

<div class="two-pane">
  <div class="pane-left">
    <% if (flash) { %><div class="confirm" style="margin-bottom:16px"><span class="sq"></span><span><%= flash %></span></div><% } %>
    <div class="kicker"><%= L.kicker %> · <span class="tnum"><%= leads.length %></span></div>
    <p class="helper"><%= L.helper %></p>
    <table class="cases">
      <thead>
        <tr><th><%= L.th.date %></th><th><%= L.th.source %></th><th><%= L.th.company %></th><th class="num"><%= L.th.amount %></th><th><%= L.th.status %></th></tr>
      </thead>
      <tbody>
        <% if (!leads.length) { %><tr><td colspan="5" style="color:var(--ink-55); padding:18px 12px"><%= L.empty %></td></tr><% } %>
        <% leads.forEach(function(l) { %>
        <tr class="row <%= sel && l.id === sel.id ? 'selected' : '' %>" onclick="location.href='/admin/leady?sel=<%= l.id %>'">
          <td class="tnum"><%= new Date(l.created_at).toLocaleDateString(t.locale, { day: 'numeric', month: 'short' }) %></td>
          <td><span class="tag tag-outline"><%= src(l) %></span></td>
          <td><%= l.company %><% if (fileCounts && fileCounts[l.id]) { %> <span title="<%= L.filesLabel %>">📎</span><% } %><% if (pendingIds && pendingIds.indexOf(l.id) !== -1) { %> <%- include('partials/hourglass', { id: 'row' + l.id }) %><% } else if (reportMap && reportMap[l.id]) { %> <span title="<%= L.research.label %>">🔎</span><% } %></td>
          <td class="num tnum"><%= D.fmt(Number(l.kwota) || 0) %></td>
          <td><span class="tag <%= stTag(l.status) %>"><%= stTxt(l.status) %></span></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <aside class="pane-right detail">
    <% if (!sel) { %>
      <div class="kicker"><%= L.kicker %></div>
      <p class="helper"><%= L.emptyDetail %></p>
    <% } else { %>
      <div class="kicker">#<%= sel.id %> · <%= src(sel) %> · <%= stTxt(sel.status) %></div>
      <h2><%= sel.company %></h2>
      <div class="amount tnum"><%= D.fmt(Number(sel.kwota) || 0) %></div>
      <p class="meta tnum"><%= dateFmt(sel.created_at) %></p>

      <hr class="rule">
      <div class="field-row"><span class="fk"><%= L.f.email %></span><span><a href="mailto:<%= sel.email %>"><%= sel.email %></a></span></div>
      <div class="field-row"><span class="fk"><%= L.f.tel %></span><span class="tnum"><% if (sel.tel) { %><a href="tel:<%= String(sel.tel).replace(/[^+\d]/g, '') %>"><%= sel.tel %></a><% } else { %>—<% } %></span></div>
      <div class="field-row"><span class="fk"><%= L.f.nip %></span><span class="tnum"><%= sel.nip || '—' %></span></div>
      <div class="field-row"><span class="fk"><%= L.f.forma %></span><span><%= sel.forma ? (t.app.formaLabels[sel.forma] || sel.forma) : '—' %></span></div>
      <% if (sel.source !== 'skup-wyrokow') { %>
      <div class="field-row"><span class="fk"><%= L.f.dni %></span><span class="tnum"><%= sel.dni != null ? t.app.days(Number(sel.dni)) : '—' %></span></div>
      <div class="field-row"><span class="fk"><%= L.f.pct %></span><span class="tnum"><%= sel.oferta_pct != null ? sel.oferta_pct + '% · ' + D.fmt(Math.round((Number(sel.kwota) || 0) * sel.oferta_pct / 100)) : '—' %></span></div>
      <% } %>
      <% if (sel.note) { %>
      <div class="label" style="margin-top:16px"><%= L.f.note %></div>
      <p style="font-size:13.5px; white-space:pre-wrap; margin:0 0 10px"><%= String(sel.note).split(' · ').join('\n') %></p>
      <% } %>
      <div class="label" style="margin-top:14px"><%= L.filesLabel %></div>
      <% if (files && files.length) { %>
      <ul class="timeline" style="margin:0 0 4px">
        <% files.forEach(function (f) { %>
        <li><span class="dot"></span><span class="t"><a href="/admin/leady/<%= sel.id %>/zalacznik/<%= f.id %>" target="_blank" rel="noopener"><%= f.filename %></a> <span class="tnum" style="color:var(--ink-55)">· <%= Math.max(1, Math.round((f.size || 0) / 1024)) %> KB</span></span></li>
        <% }) %>
      </ul>
      <% } else { %>
      <p class="helper" style="margin:0"><%= L.noFiles %></p>
      <% } %>

      <hr class="rule">
      <form class="calc-form" method="post" action="/admin/leady/<%= sel.id %>" style="margin:0; padding:0; border:0; box-shadow:none; background:transparent">
        <div class="fg">
          <label for="status"><%= L.statusLabel %></label>
          <select id="status" name="status">
            <% LEAD_STATUSES.forEach(function(s) { %><option value="<%= s %>" <%= (sel.status || 'nowy') === s ? 'selected' : '' %>><%= L.statuses[s] %></option><% }) %>
          </select>
        </div>
        <div class="fg">
          <label for="admin_note"><%= L.noteLabel %></label>
          <textarea id="admin_note" name="admin_note" rows="4" placeholder="<%= L.notePh %>"><%= sel.admin_note || '' %></textarea>
        </div>
        <div style="display:flex; gap:12px; flex-wrap:wrap; align-items:center">
          <button class="btn chan-btn" type="submit"><%= L.save %></button>
          <a class="btn btn-secondary chan-btn" href="mailto:<%= sel.email %>?subject=<%= encodeURIComponent('sprzedamfakture.pl — ' + sel.company) %>"><%= L.mailBtn %></a>
        </div>
      </form>
      <% if (sel.updated_at) { %><p class="helper" style="margin:10px 0 0"><%= L.f.updated %>: <%= dateFmt(sel.updated_at) %></p><% } %>

      <hr class="rule">
      <div class="label" style="display:flex; justify-content:space-between; gap:12px; flex-wrap:wrap; align-items:center"><span><%= L.research.label %></span>
        <form method="post" action="/admin/leady/<%= sel.id %>/raport" style="margin:0"><button class="btn btn-secondary chan-btn" type="submit" <% if (researchPending) { %>disabled aria-busy="true"<% } %>><% if (researchPending) { %><%- include('partials/hourglass', { id: 'btn' }) %><%= L.research.busy %><% } else { %><%= report ? L.research.redo : L.research.run %><% } %></button></form>
      </div>
      <% if (researchPending) { %><p class="research-busy" role="status"><%- include('partials/hourglass', { id: 'txt' }) %><span><%= L.research.pending %></span></p><% } %>
      <% if (report) { %>
        <%- include('partials/research', { report: report }) %>
      <% } else if (!researchPending) { %>
        <p class="helper" style="margin:0"><%= L.research.none %></p>
      <% } %>

      <hr class="rule">
      <div class="label"><%= L.caseKicker %></div>
      <% if (sel.case_id) { %>
        <p style="margin:0"><a class="btn btn-secondary chan-btn" href="/app/sprawy?sel=<%= sel.case_id %>"><%= L.caseLink %></a></p>
      <% } else { %>
        <p class="helper" style="margin:0 0 6px"><%= L.caseHint %></p>
        <% var kd = (report && report.facts && report.facts.debtor) || {}; var mfName = (kd.mf && kd.mf.found && kd.mf.name) || ''; var krsMail = (kd.krs && kd.krs.found && kd.krs.email) || '';
           var isW = sel.source === 'skup-wyrokow'; var parts = String(sel.note || '').split(' · '); var regName = '', dl = '', sygn = '';
           parts.forEach(function (p) {
             var m1 = /^dłużnik: (.+)$/.exec(p); if (m1) dl = m1[1];
             var m2 = /^wyrok (.+)$/.exec(p); if (m2) sygn = m2[1];
             if (!isW && !regName && p.indexOf('lang=') !== 0 && p.indexOf('VAT:') !== 0) regName = p;
           }); %>
        <form class="calc-form flat" method="post" action="/admin/leady/<%= sel.id %>/sprawa">
          <div class="fg"><label for="c-nr"><%= R.f.nr %></label><input id="c-nr" name="nr" value="<%= isW ? sygn : '' %>"></div>
          <div class="fg"><label for="c-debtor"><%= R.f.debtor %></label><input id="c-debtor" name="debtor" value="<%= isW ? (dl || mfName) : (regName || mfName) %>" required></div>
          <div class="fg"><label for="c-email"><%= R.f.email %></label><input id="c-email" name="email" type="email" value="<%= krsMail %>"></div>
          <div class="fg"><label for="c-tel"><%= R.f.tel %></label><input id="c-tel" name="tel"></div>
          <div class="fg"><label for="c-nip"><%= R.f.nip %></label><input id="c-nip" name="nip" class="tnum" value="<%= sel.nip || '' %>"></div>
          <div class="fg"><label for="c-amount"><%= R.f.amount %></label><input id="c-amount" name="amount" class="tnum" inputmode="decimal" value="<%= Number(sel.kwota) || '' %>" required></div>
          <div class="fg"><label for="c-days"><%= R.f.days %></label><input id="c-days" name="days" type="number" min="0" class="tnum" value="<%= isW ? '' : (sel.dni != null ? sel.dni : '') %>"></div>
          <div class="fg"><label for="c-due"><%= R.f.due %></label><input id="c-due" name="dueDate" type="date" class="tnum"></div>
          <div class="fg"><label for="c-client"><%= R.f.client %></label><input id="c-client" name="clientCompany" value="<%= sel.company %>"></div>
          <div class="fg"><label for="c-cemail"><%= R.f.clientEmail %></label><input id="c-cemail" name="clientEmail" type="email" value="<%= sel.email %>"></div>
          <div class="fg"><label for="c-note"><%= R.f.note %></label><textarea id="c-note" name="note" rows="2"><%= sel.admin_note || '' %></textarea></div>
          <button class="btn chan-btn" type="submit"><%= L.caseBtn %></button>
        </form>
      <% } %>

      <hr class="rule">
      <form method="post" action="/admin/leady/<%= sel.id %>/usun" onsubmit="return confirm('<%= L.delConfirm %>')">
        <button class="btn btn-ghost chan-btn" type="submit" style="color:var(--danger)"><%= L.del %></button>
      </form>
    <% } %>
  </aside>
</div>

<%- include('partials/footer') %>

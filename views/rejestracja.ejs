<% var R = t.app.register; %>
<%- include('partials/head', { title: t.app.titles.register + ' — sprzedamfakture.pl' }) %>
<%- include('partials/nav') %>

<div class="calc-wrap auth-wrap" style="flex:1">
  <div class="kicker"><%= R.kicker %></div>
  <h1 style="font-size:32px"><%= R.h %></h1>
  <p class="helper"><%= R.helper %></p>

  <form class="calc-form" method="post" action="/rejestracja">
    <% if (error) { %><div class="form-error" role="alert"><%= error %></div><% } %>
    <div class="fg">
      <label for="company"><%= R.company %></label>
      <input type="text" id="company" name="company" value="<%= form.company %>" autocomplete="organization" required>
    </div>
    <div class="fg">
      <label for="nip"><%= R.nip %></label>
      <input type="text" id="nip" name="nip" class="tnum" value="<%= form.nip %>">
    </div>
    <div class="fg">
      <label for="email"><%= R.email %></label>
      <input type="email" id="email" name="email" autocomplete="username" value="<%= form.email %>" required>
    </div>
    <div class="fg">
      <label for="password"><%= R.password %></label>
      <input type="password" id="password" name="password" autocomplete="new-password" required>
    </div>
    <div class="fg">
      <label for="password2"><%= R.password2 %></label>
      <input type="password" id="password2" name="password2" autocomplete="new-password" required>
    </div>
    <button class="btn" type="submit"><%= R.btn %></button>
  </form>

  <p style="font-size:13.5px"><%= R.have %> <a href="/login"><%= R.login %></a></p>
</div>

<%- include('partials/footer') %>
